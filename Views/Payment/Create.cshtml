@model TravelAI.Models.Booking

@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="text-center mb-4">
                <div class="display-4 mb-3">💳</div>

                <h1 class="fw-bold">
                    Thanh toán đặt tour
                </h1>

                <p class="text-muted">
                    Vui lòng chọn phương thức thanh toán cho đơn đặt tour của bạn.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white p-4">

                    <div class="small opacity-75">
                        MÃ ĐẶT TOUR
                    </div>

                    <h4 class="fw-bold mb-0">
                        @Model.BookingCode
                    </h4>

                </div>

                <div class="card-body p-4 p-lg-5">

                    @if (Model.Tour != null)
                    {
                        <div class="mb-4">

                            <h5 class="fw-bold mb-3">
                                Thông tin tour
                            </h5>

                            <div class="d-flex gap-3 align-items-center">

                                @if (!string.IsNullOrWhiteSpace(Model.Tour.ImageUrl))
                                {
                                    <img src="@Model.Tour.ImageUrl"
                                         alt="@Model.Tour.Name"
                                         style="width:120px;height:90px;object-fit:cover;"
                                         class="rounded-3" />
                                }

                                <div>
                                    <div class="fw-bold">
                                        @Model.Tour.Name
                                    </div>

                                    <div class="text-muted small mt-1">
                                        Số người:
                                        <strong>
                                            @Model.NumberOfPeople
                                        </strong>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <hr />
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <span class="fw-semibold fs-5">
                            Tổng tiền
                        </span>

                        <span class="text-danger fw-bold fs-2">
                            @Model.TotalPrice.ToString("N0") đ
                        </span>

                    </div>

                    <form asp-action="Create"
                          asp-controller="Payment"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="bookingId"
                               value="@Model.Id" />

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Phương thức thanh toán
                            </label>

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <label class="border rounded-3 p-3 w-100 h-100"
                                           style="cursor:pointer;">

                                        <input type="radio"
                                               name="paymentMethod"
                                               value="Cash"
                                               class="form-check-input me-2"
                                               required />

                                        <strong>💵 Tiền mặt</strong>

                                        <div class="small text-muted mt-2">
                                            Thanh toán trực tiếp
                                        </div>

                                    </label>

                                </div>

                                <div class="col-md-4">

                                    <label class="border rounded-3 p-3 w-100 h-100"
                                           style="cursor:pointer;">

                                        <input type="radio"
                                               name="paymentMethod"
                                               value="BankTransfer"
                                               class="form-check-input me-2" />

                                        <strong>🏦 Chuyển khoản</strong>

                                        <div class="small text-muted mt-2">
                                            Chuyển khoản ngân hàng
                                        </div>

                                    </label>

                                </div>

                                <div class="col-md-4">

                                    <label class="border rounded-3 p-3 w-100 h-100"
                                           style="cursor:pointer;">

                                        <input type="radio"
                                               name="paymentMethod"
                                               value="VNPay"
                                               class="form-check-input me-2" />

                                        <strong>💳 VNPay</strong>

                                        <div class="small text-muted mt-2">
                                            Thanh toán điện tử
                                        </div>

                                    </label>

                                </div>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="note"
                                   class="form-label fw-bold">
                                Ghi chú
                            </label>

                            <textarea id="note"
                                      name="note"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Nhập ghi chú nếu cần..."></textarea>

                        </div>

                        <div class="d-flex gap-3">

                            <a asp-controller="Booking"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary flex-fill">
                                ← Quay lại
                            </a>

                            <button type="submit"
                                    class="btn btn-success flex-fill">
                                💳 Xác nhận thanh toán
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>