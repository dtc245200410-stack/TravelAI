@model TravelAI.Models.Payment

@{
    ViewData["Title"] = "Thanh toán thành công";

    bool isTour = Model.BookingId.HasValue;
    bool isHotel = Model.HotelBookingId.HasValue;

    var bookingCode = isTour
        ? Model.Booking?.BookingCode
        : Model.HotelBooking?.BookingCode;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- Thông báo -->
            <div class="text-center mb-4">

                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 70px;"></i>
                </div>

                <h2 class="fw-bold">
                    Đã tạo yêu cầu thanh toán!
                </h2>

                <p class="text-muted">
                    Giao dịch của bạn đã được ghi nhận và đang chờ xác nhận.
                </p>

            </div>


            <!-- Thông tin thanh toán -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-receipt me-2"></i>
                        Thông tin thanh toán
                    </h5>


                    <!-- Mã thanh toán -->
                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Mã thanh toán
                        </div>

                        <div class="col-sm-7 fw-semibold">
                            @Model.PaymentCode
                        </div>

                    </div>


                    <!-- Loại dịch vụ -->
                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Loại dịch vụ
                        </div>

                        <div class="col-sm-7 fw-semibold">

                            @if (isTour)
                            {
                                <span>
                                    <i class="bi bi-map me-1"></i>
                                    Tour du lịch
                                </span>
                            }
                            else if (isHotel)
                            {
                                <span>
                                    <i class="bi bi-building me-1"></i>
                                    Đặt phòng khách sạn
                                </span>
                            }

                        </div>

                    </div>


                    <!-- Mã đơn -->
                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Mã đơn hàng
                        </div>

                        <div class="col-sm-7 fw-semibold">
                            @bookingCode
                        </div>

                    </div>


                    <!-- Tên dịch vụ -->
                    @if (isTour && Model.Booking?.Tour != null)
                    {
                        <div class="row mb-3">

                            <div class="col-sm-5 text-muted">
                                Tour
                            </div>

                            <div class="col-sm-7 fw-semibold">
                                @Model.Booking.Tour.Name
                            </div>

                        </div>
                    }

                    @if (isHotel && Model.HotelBooking?.Hotel != null)
                    {
                        <div class="row mb-3">

                            <div class="col-sm-5 text-muted">
                                Khách sạn
                            </div>

                            <div class="col-sm-7 fw-semibold">
                                @Model.HotelBooking.Hotel.Name
                            </div>

                        </div>
                    }


                    <!-- Phòng -->
                    @if (isHotel && Model.HotelBooking?.Room != null)
                    {
                        <div class="row mb-3">

                            <div class="col-sm-5 text-muted">
                                Phòng
                            </div>

                            <div class="col-sm-7 fw-semibold">
                                @Model.HotelBooking.Room.RoomName
                            </div>

                        </div>
                    }


                    <!-- Phương thức -->
                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Phương thức thanh toán
                        </div>

                        <div class="col-sm-7 fw-semibold">
                            @Model.PaymentMethod
                        </div>

                    </div>


                    <!-- Trạng thái -->
                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Trạng thái
                        </div>

                        <div class="col-sm-7">

                            <span class="badge bg-warning text-dark px-3 py-2">
                                @Model.Status
                            </span>

                        </div>

                    </div>


                    <!-- Số tiền -->
                    <div class="row pt-3 border-top">

                        <div class="col-sm-5 fw-bold">
                            Tổng thanh toán
                        </div>

                        <div class="col-sm-7 fw-bold text-success fs-5">
                            @Model.Amount.ToString("N0") đ
                        </div>

                    </div>

                </div>

            </div>


            <!-- Nút điều hướng -->
            <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">

                @if (isTour && Model.Booking != null)
                {
                    <a asp-controller="Booking"
                       asp-action="Details"
                       asp-route-id="@Model.Booking.Id"
                       class="btn btn-primary rounded-3 px-4">

                        <i class="bi bi-receipt me-2"></i>
                        Xem đơn Tour

                    </a>
                }

                @if (isHotel && Model.HotelBooking != null)
                {
                    <a asp-controller="Hotel"
                       asp-action="BookingDetails"
                       asp-route-id="@Model.HotelBooking.Id"
                       class="btn btn-primary rounded-3 px-4">

                        <i class="bi bi-building me-2"></i>
                        Xem đơn phòng

                    </a>
                }

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="btn btn-outline-secondary rounded-3 px-4">

                    <i class="bi bi-list-ul me-2"></i>
                    Đơn của tôi

                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-dark rounded-3 px-4">

                    <i class="bi bi-house me-2"></i>
                    Trang chủ

                </a>

            </div>

        </div>

    </div>

</div>