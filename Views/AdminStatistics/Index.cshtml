@{
    ViewData["Title"] = "Thống kê hệ thống";

    var totalUsers = (int)(ViewBag.TotalUsers ?? 0);
    var totalTours = (int)(ViewBag.TotalTours ?? 0);
    var totalHotels = (int)(ViewBag.TotalHotels ?? 0);
    var totalRooms = (int)(ViewBag.TotalRooms ?? 0);

    var totalTourBookings = (int)(ViewBag.TotalTourBookings ?? 0);
    var totalHotelBookings = (int)(ViewBag.TotalHotelBookings ?? 0);

    var pendingTourBookings = (int)(ViewBag.PendingTourBookings ?? 0);
    var confirmedTourBookings = (int)(ViewBag.ConfirmedTourBookings ?? 0);
    var cancelledTourBookings = (int)(ViewBag.CancelledTourBookings ?? 0);

    var tourRevenue = (decimal)(ViewBag.TourRevenue ?? 0m);
    var hotelRevenue = (decimal)(ViewBag.HotelRevenue ?? 0m);
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? 0m);

    var totalTourStatus =
        pendingTourBookings +
        confirmedTourBookings +
        cancelledTourBookings;

    var pendingPercent = totalTourStatus > 0
        ? Math.Round((double)pendingTourBookings / totalTourStatus * 100, 1)
        : 0;

    var confirmedPercent = totalTourStatus > 0
        ? Math.Round((double)confirmedTourBookings / totalTourStatus * 100, 1)
        : 0;

    var cancelledPercent = totalTourStatus > 0
        ? Math.Round((double)cancelledTourBookings / totalTourStatus * 100, 1)
        : 0;
}

<style>
    .statistics-page {
        padding: 30px;
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
    }

    .statistics-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .statistics-title h2 {
        margin: 0;
        font-weight: 700;
        color: #1f2937;
    }

    .statistics-title p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .back-button {
        text-decoration: none;
        background: white;
        color: #374151;
        padding: 10px 18px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        font-weight: 600;
    }

        .back-button:hover {
            background: #f3f4f6;
            color: #111827;
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        border: 1px solid #eef0f4;
        box-shadow: 0 5px 20px rgba(0,0,0,0.04);
    }

        .stat-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 15px;
            background: #eef2ff;
            color: #4f46e5;
        }

        .stat-card h6 {
            color: #6b7280;
            margin-bottom: 7px;
            font-size: 14px;
        }

        .stat-card h3 {
            margin: 0;
            font-size: 27px;
            font-weight: 700;
            color: #111827;
        }

        .stat-card small {
            display: block;
            margin-top: 7px;
            color: #9ca3af;
        }

    .revenue-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid #eef0f4;
        box-shadow: 0 5px 20px rgba(0,0,0,0.04);
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 22px;
    }

    .revenue-total {
        font-size: 32px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 20px;
    }

    .revenue-row {
        margin-bottom: 18px;
    }

    .revenue-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 7px;
        font-size: 14px;
    }

        .revenue-info span:first-child {
            color: #6b7280;
        }

        .revenue-info span:last-child {
            font-weight: 700;
            color: #111827;
        }

    .progress {
        height: 10px;
        background: #eef0f4;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: 20px;
    }

    .tour-bar {
        background: #4f46e5;
    }

    .hotel-bar {
        background: #10b981;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .content-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid #eef0f4;
        box-shadow: 0 5px 20px rgba(0,0,0,0.04);
    }

    .booking-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .booking-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pending {
        background: #fff7ed;
        color: #ea580c;
    }

    .confirmed {
        background: #ecfdf5;
        color: #059669;
    }

    .cancelled {
        background: #fef2f2;
        color: #dc2626;
    }

    .booking-info {
        flex: 1;
    }

        .booking-info strong {
            display: block;
            color: #374151;
            margin-bottom: 4px;
        }

        .booking-info span {
            color: #9ca3af;
            font-size: 13px;
        }

    .booking-number {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
    }

    .system-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .system-item {
        padding: 18px;
        border-radius: 12px;
        background: #f9fafb;
        border: 1px solid #f0f1f3;
    }

        .system-item span {
            display: block;
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .system-item strong {
            font-size: 22px;
            color: #111827;
        }

    @@media (max-width: 1100px) {
        .stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .statistics-page {
            padding: 15px;
        }

        .statistics-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .stat-grid {
            grid-template-columns: 1fr;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="statistics-page">

    <!-- HEADER -->
    <div class="statistics-header">
        <div class="statistics-title">
            <h2>
                <i class="bi bi-bar-chart-line"></i>
                Thống kê hệ thống
            </h2>
            <p>Tổng quan hoạt động của TravelAI</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="back-button">
            <i class="bi bi-arrow-left"></i>
            Quay lại Dashboard
        </a>
    </div>


    <!-- TỔNG QUAN -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="icon">
                <i class="bi bi-people"></i>
            </div>

            <h6>Người dùng</h6>
            <h3>@totalUsers</h3>
            <small>Tài khoản trong hệ thống</small>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="bi bi-map"></i>
            </div>

            <h6>Tour du lịch</h6>
            <h3>@totalTours</h3>
            <small>Tổng số tour</small>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="bi bi-building"></i>
            </div>

            <h6>Khách sạn</h6>
            <h3>@totalHotels</h3>
            <small>Tổng số khách sạn</small>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="bi bi-door-open"></i>
            </div>

            <h6>Phòng</h6>
            <h3>@totalRooms</h3>
            <small>Tổng số phòng</small>
        </div>

    </div>


    <!-- DOANH THU -->
    <div class="revenue-card">

        <div class="section-title">
            <i class="bi bi-cash-stack"></i>
            Doanh thu
        </div>

        <div class="revenue-total">
            @totalRevenue.ToString("N0") ₫
        </div>


        @{
            var tourRevenuePercent = totalRevenue > 0
                ? (double)(tourRevenue / totalRevenue * 100)
                : 0;

            var hotelRevenuePercent = totalRevenue > 0
                ? (double)(hotelRevenue / totalRevenue * 100)
                : 0;
        }


        <div class="revenue-row">

            <div class="revenue-info">
                <span>Doanh thu Tour</span>
                <span>@tourRevenue.ToString("N0") ₫</span>
            </div>

            <div class="progress">
                <div class="progress-bar tour-bar"
                     style="width:@tourRevenuePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </div>


        <div class="revenue-row">

            <div class="revenue-info">
                <span>Doanh thu Khách sạn</span>
                <span>@hotelRevenue.ToString("N0") ₫</span>
            </div>

            <div class="progress">
                <div class="progress-bar hotel-bar"
                     style="width:@hotelRevenuePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </div>

    </div>


    <!-- BOOKING + HỆ THỐNG -->
    <div class="content-grid">

        <!-- TRẠNG THÁI BOOKING -->
        <div class="content-card">

            <div class="section-title">
                <i class="bi bi-receipt"></i>
                Trạng thái Booking Tour
            </div>


            <div class="booking-row">

                <div class="booking-icon pending">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div class="booking-info">
                    <strong>Đang chờ</strong>
                    <span>@pendingPercent% tổng booking</span>
                </div>

                <div class="booking-number">
                    @pendingTourBookings
                </div>

            </div>


            <div class="booking-row">

                <div class="booking-icon confirmed">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="booking-info">
                    <strong>Đã xác nhận</strong>
                    <span>@confirmedPercent% tổng booking</span>
                </div>

                <div class="booking-number">
                    @confirmedTourBookings
                </div>

            </div>


            <div class="booking-row">

                <div class="booking-icon cancelled">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div class="booking-info">
                    <strong>Đã hủy</strong>
                    <span>@cancelledPercent% tổng booking</span>
                </div>

                <div class="booking-number">
                    @cancelledTourBookings
                </div>

            </div>

        </div>


        <!-- THỐNG KÊ HỆ THỐNG -->
        <div class="content-card">

            <div class="section-title">
                <i class="bi bi-database"></i>
                Tổng quan dữ liệu
            </div>

            <div class="system-grid">

                <div class="system-item">
                    <span>Booking Tour</span>
                    <strong>@totalTourBookings</strong>
                </div>

                <div class="system-item">
                    <span>Booking Khách sạn</span>
                    <strong>@totalHotelBookings</strong>
                </div>

                <div class="system-item">
                    <span>Tour</span>
                    <strong>@totalTours</strong>
                </div>

                <div class="system-item">
                    <span>Khách sạn</span>
                    <strong>@totalHotels</strong>
                </div>

            </div>

        </div>

    </div>

</div>