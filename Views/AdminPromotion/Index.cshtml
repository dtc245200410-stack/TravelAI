@using TravelAI.Models
@model IEnumerable<Promotion>

@{
    ViewData["Title"] = "Quản lý khuyến mãi";

    var today = DateTime.Now;

    var activePromotions = Model.Count(x =>
        x.IsActive &&
        x.StartDate <= today &&
        x.EndDate >= today);

    var expiredPromotions = Model.Count(x =>
        x.EndDate < today);

    var upcomingPromotions = Model.Count(x =>
        x.StartDate > today);
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-ticket-perforated"></i>
                Quản lý khuyến mãi
            </h2>

            <p class="text-muted mb-0">
                Quản lý mã giảm giá và chương trình khuyến mãi
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Quay lại Dashboard

        </a>

    </div>


    <!-- THỐNG KÊ -->
    <div class="row g-4 mb-4">

        <!-- Tổng -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Tổng khuyến mãi
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.Count()
                            </h3>
                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Đang hoạt động -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Đang hoạt động
                            </p>

                            <h3 class="fw-bold text-success mb-0">
                                @activePromotions
                            </h3>
                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Sắp diễn ra -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Sắp diễn ra
                            </p>

                            <h3 class="fw-bold text-info mb-0">
                                @upcomingPromotions
                            </h3>
                        </div>

                        <div class="fs-1 text-info">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Hết hạn -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Đã hết hạn
                            </p>

                            <h3 class="fw-bold text-danger mb-0">
                                @expiredPromotions
                            </h3>
                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- DANH SÁCH -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul"></i>
                Danh sách mã khuyến mãi
            </h5>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>

                                <th>Mã</th>

                                <th>Tên chương trình</th>

                                <th>Giảm giá</th>

                                <th>Đơn tối thiểu</th>

                                <th>Thời gian</th>

                                <th>Sử dụng</th>

                                <th>Trạng thái</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var promotion in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>
                                        <strong>
                                            #@promotion.Id
                                        </strong>
                                    </td>


                                    <!-- CODE -->
                                    <td>

                                        <span class="badge bg-dark fs-6">
                                            @promotion.Code
                                        </span>

                                    </td>


                                    <!-- NAME -->
                                    <td>

                                        <strong>
                                            @promotion.Name
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(promotion.Description))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @promotion.Description
                                            </small>
                                        }

                                    </td>


                                    <!-- DISCOUNT -->
                                    <td>

                                        @if (promotion.DiscountType == "Percent")
                                        {
                                            <strong class="text-success">
                                                @promotion.DiscountValue.ToString("0.##")%
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-success">
                                                @promotion.DiscountValue.ToString("N0") ₫
                                            </strong>
                                        }

                                    </td>


                                    <!-- MINIMUM ORDER -->
                                    <td>

                                        @if (promotion.MinimumOrderValue.HasValue)
                                        {
                                            @promotion.MinimumOrderValue.Value.ToString("N0")
                                            @:₫
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Không yêu cầu
                                            </span>
                                        }

                                    </td>


                                    <!-- DATE -->
                                    <td>

                                        <small>
                                            @promotion.StartDate.ToString("dd/MM/yyyy")
                                            -
                                            @promotion.EndDate.ToString("dd/MM/yyyy")
                                        </small>

                                    </td>


                                    <!-- USAGE -->
                                    <td>

                                        @promotion.UsedCount /
                                        @promotion.UsageLimit

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (!promotion.IsActive)
                                        {
                                            <span class="badge bg-secondary">
                                                Đã tắt
                                            </span>
                                        }
                                        else if (promotion.EndDate < today)
                                        {
                                            <span class="badge bg-danger">
                                                Hết hạn
                                            </span>
                                        }
                                        else if (promotion.StartDate > today)
                                        {
                                            <span class="badge bg-info">
                                                Sắp diễn ra
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Đang hoạt động
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="fs-1 text-muted mb-3">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>

                    <h5>
                        Chưa có chương trình khuyến mãi
                    </h5>

                    <p class="text-muted mb-0">
                        Các mã khuyến mãi sẽ xuất hiện tại đây.
                    </p>

                </div>
            }

        </div>

    </div>

</div>