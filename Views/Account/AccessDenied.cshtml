@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div style="
    min-height: 70vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px;
    ">

    <div style="
        text-align:center;
        background:white;
        padding:50px;
        border-radius:20px;
        max-width:500px;
        box-shadow:0 10px 40px rgba(0,0,0,.08);
        ">

        <div style="
            width:80px;
            height:80px;
            margin:0 auto 20px;
            border-radius:50%;
            background:#fee2e2;
            color:#dc2626;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:35px;
            ">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h2>Không có quyền truy cập</h2>

        <p style="color:#6b7280;">
            Tài khoản của bạn không có quyền truy cập vào khu vực này.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary mt-3">
            Quay về trang chủ
        </a>

    </div>

</div>