@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-10 col-xl-9">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="row g-0">

                    <!-- ================= LEFT SIDE ================= -->

                    <div class="col-md-6 d-flex align-items-center bg-primary text-white">

                        <div class="p-5 w-100">

                            <div class="mb-4">
                                <i class="bi bi-airplane-engines fs-1"></i>
                            </div>

                            <h1 class="fw-bold mb-3">
                                Chào mừng đến TravelAI
                            </h1>

                            <p class="lead mb-4">
                                Khám phá những hành trình tuyệt vời
                                và để AI giúp bạn lên kế hoạch cho chuyến đi.
                            </p>

                            <div class="d-flex gap-4 flex-wrap">

                                <div>
                                    <div class="fs-4 fw-bold">
                                        100+
                                    </div>

                                    <div class="small">
                                        Tour du lịch
                                    </div>
                                </div>

                                <div>
                                    <div class="fs-4 fw-bold">
                                        50+
                                    </div>

                                    <div class="small">
                                        Khách sạn
                                    </div>
                                </div>

                                <div>
                                    <div class="fs-4 fw-bold">
                                        AI
                                    </div>

                                    <div class="small">
                                        Trợ lý du lịch
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================= RIGHT SIDE ================= -->

                    <div class="col-md-6">

                        <div class="p-5">

                            <div class="text-center mb-4">

                                <h2 class="fw-bold mb-2">
                                    Đăng nhập
                                </h2>

                                <p class="text-muted mb-0">
                                    Đăng nhập để quản lý chuyến đi của bạn
                                </p>

                            </div>


                            <!-- ================= LOGIN FORM ================= -->

                            <form asp-controller="Account"
                                  asp-action="Login"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <!-- ================= SUCCESS ================= -->
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success rounded-3 mb-4">

                                        <i class="bi bi-check-circle me-2"></i>

                                        @TempData["Success"]

                                    </div>
                                }


                                <!-- ================= ERROR ================= -->
                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert alert-danger rounded-3 mb-4">

                                        <i class="bi bi-exclamation-circle me-2"></i>

                                        @ViewBag.Error

                                    </div>
                                }


                                <!-- ================= EMAIL ================= -->

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Email
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-envelope"></i>
                                        </span>

                                        <input type="email"
                                               class="form-control"
                                               name="email"
                                               placeholder="Nhập email của bạn"
                                               autocomplete="email"
                                               required />

                                    </div>

                                </div>


                                <!-- ================= PASSWORD ================= -->

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Mật khẩu
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-lock"></i>
                                        </span>

                                        <input type="password"
                                               class="form-control"
                                               name="password"
                                               placeholder="Nhập mật khẩu"
                                               autocomplete="current-password"
                                               required />

                                    </div>

                                </div>


                                <!-- ================= REMEMBER + FORGOT ================= -->

                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="rememberMe"
                                               value="true"
                                               id="rememberMe" />

                                        <label class="form-check-label"
                                               for="rememberMe">

                                            Ghi nhớ đăng nhập

                                        </label>

                                    </div>

                                    <a href="#"
                                       class="text-decoration-none">

                                        Quên mật khẩu?

                                    </a>

                                </div>


                                <!-- ================= LOGIN BUTTON ================= -->

                                <button type="submit"
                                        class="btn btn-primary w-100 py-2 rounded-3">

                                    <i class="bi bi-box-arrow-in-right me-2"></i>

                                    Đăng nhập

                                </button>

                            </form>


                            <!-- ================= REGISTER ================= -->

                            <div class="text-center mt-4">

                                <span class="text-muted">
                                    Chưa có tài khoản?
                                </span>

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="fw-semibold text-decoration-none ms-1">

                                    Đăng ký ngay

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>