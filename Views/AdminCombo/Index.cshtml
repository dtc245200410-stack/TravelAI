@using TravelAI.Models
@model IEnumerable<Combo>

@{
    ViewData["Title"] = "Quản lý Combo";

    var today = DateTime.Now;

    // Combo đang hoạt động
    var activeCombos = Model.Count(x =>
        x.Status == "Active" &&
        (!x.StartDate.HasValue || x.StartDate <= today) &&
        (!x.EndDate.HasValue || x.EndDate >= today));

    // Combo đã hết hạn
    var expiredCombos = Model.Count(x =>
        x.EndDate.HasValue &&
        x.EndDate.Value < today);

    // Combo sắp diễn ra
    var upcomingCombos = Model.Count(x =>
        x.Status == "Active" &&
        x.StartDate.HasValue &&
        x.StartDate.Value > today);
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam"></i>
                Quản lý Combo
            </h2>

            <p class="text-muted mb-0">
                Quản lý các gói dịch vụ và combo du lịch của TravelAI
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Quay lại Dashboard

        </a>

    </div>


    <!-- ================= THỐNG KÊ ================= -->

    <div class="row g-4 mb-4">

        <!-- Tổng Combo -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Tổng Combo
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.Count()
                            </h3>

                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Đang hoạt động -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Đang hoạt động
                            </p>

                            <h3 class="fw-bold text-success mb-0">
                                @activeCombos
                            </h3>

                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Sắp diễn ra -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Sắp diễn ra
                            </p>

                            <h3 class="fw-bold text-info mb-0">
                                @upcomingCombos
                            </h3>

                        </div>

                        <div class="fs-1 text-info">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Hết hạn -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Đã hết hạn
                            </p>

                            <h3 class="fw-bold text-danger mb-0">
                                @expiredCombos
                            </h3>

                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= DANH SÁCH COMBO ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-list-ul"></i>
                Danh sách Combo

            </h5>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>

                                <th>Tên Combo</th>

                                <th>Điểm đến</th>

                                <th>Thời lượng</th>

                                <th>Giá</th>

                                <th>Số người</th>

                                <th>Thời gian</th>

                                <th>Trạng thái</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var combo in Model)
                            {
                                <tr>

                                    <!-- ID -->

                                    <td>

                                        <strong>
                                            #@combo.Id
                                        </strong>

                                    </td>


                                    <!-- TÊN COMBO -->

                                    <td>

                                        <strong>
                                            @combo.Name
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(combo.Description))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @combo.Description
                                            </small>
                                        }

                                    </td>


                                    <!-- ĐIỂM ĐẾN -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(combo.Destination))
                                        {
                                            <span>
                                                @combo.Destination
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa xác định
                                            </span>
                                        }

                                    </td>


                                    <!-- THỜI LƯỢNG -->

                                    <td>

                                        @combo.Duration ngày

                                    </td>


                                    <!-- GIÁ -->

                                    <td>

                                        @if (combo.SalePrice.HasValue &&
                                             combo.SalePrice.Value < combo.Price)
                                        {
                                            <div>

                                                <span class="text-muted text-decoration-line-through">
                                                    @combo.Price.ToString("N0") ₫
                                                </span>

                                            </div>

                                            <strong class="text-success">
                                                @combo.SalePrice.Value.ToString("N0") ₫
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-success">
                                                @combo.Price.ToString("N0") ₫
                                            </strong>
                                        }

                                    </td>


                                    <!-- SỐ NGƯỜI -->

                                    <td>

                                        <div>
                                            Tối đa:
                                            <strong>
                                                @combo.MaxPeople
                                            </strong>
                                        </div>

                                        <small class="text-muted">
                                            Còn @combo.AvailablePeople chỗ
                                        </small>

                                    </td>


                                    <!-- THỜI GIAN -->

                                    <td>

                                        @if (combo.StartDate.HasValue ||
                                             combo.EndDate.HasValue)
                                        {
                                            <small>

                                                @(combo.StartDate.HasValue
                                                    ? combo.StartDate.Value.ToString("dd/MM/yyyy")
                                                    : "...")

                                                -

                                                @(combo.EndDate.HasValue
                                                    ? combo.EndDate.Value.ToString("dd/MM/yyyy")
                                                    : "...")

                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Không giới hạn
                                            </span>
                                        }

                                    </td>


                                    <!-- TRẠNG THÁI -->

                                    <td>

                                        @if (combo.Status != "Active")
                                        {
                                            <span class="badge bg-secondary">
                                                @combo.Status
                                            </span>
                                        }
                                        else if (combo.EndDate.HasValue &&
                                                 combo.EndDate.Value < today)
                                        {
                                            <span class="badge bg-danger">
                                                Hết hạn
                                            </span>
                                        }
                                        else if (combo.StartDate.HasValue &&
                                                 combo.StartDate.Value > today)
                                        {
                                            <span class="badge bg-info">
                                                Sắp diễn ra
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Đang hoạt động
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- KHÔNG CÓ COMBO -->

                <div class="text-center py-5">

                    <div class="fs-1 text-muted mb-3">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <h5>
                        Chưa có Combo
                    </h5>

                    <p class="text-muted mb-0">

                        Các Combo sẽ xuất hiện tại đây
                        khi được thêm vào hệ thống.

                    </p>

                </div>
            }

        </div>

    </div>

</div>