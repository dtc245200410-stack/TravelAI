@model IEnumerable<TravelAI.Models.AIConversation>

@{
    ViewData["Title"] = "Quản lý Travel AI";
}

<style>
    .admin-ai-page {
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
    }

    .admin-ai-header {
        background: linear-gradient(135deg, #0d6efd, #2563eb);
        color: white;
        border-radius: 18px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
    }

    .admin-ai-header h2 {
        font-weight: 700;
        margin-bottom: 6px;
    }

    .admin-ai-header p {
        margin: 0;
        opacity: .9;
    }

    .ai-status {
        background: rgba(255, 255, 255, .15);
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 14px;
    }

    .ai-chat-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, .07);
    }

    .ai-chat-header {
        background: linear-gradient(135deg, #0d6efd, #2563eb);
        color: white;
        padding: 18px 22px;
    }

    .ai-chat-header h5 {
        margin: 0;
        font-weight: 700;
    }

    .ai-chat-header small {
        opacity: .9;
    }

    .admin-chat-box {
        height: 430px;
        overflow-y: auto;
        padding: 25px;
        background: #f8fafc;
    }

    .admin-welcome {
        text-align: center;
        padding: 45px 20px;
    }

    .admin-welcome-icon {
        font-size: 55px;
    }

    .admin-welcome h4 {
        margin-top: 15px;
        font-weight: 700;
    }

    .admin-message {
        display: flex;
        margin-bottom: 18px;
    }

    .admin-message.user {
        justify-content: flex-end;
    }

    .admin-message.ai {
        justify-content: flex-start;
    }

    .admin-message-content {
        max-width: 75%;
        padding: 13px 17px;
        border-radius: 16px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .admin-message.user .admin-message-content {
        background: #0d6efd;
        color: white;
        border-bottom-right-radius: 4px;
    }

    .admin-message.ai .admin-message-content {
        background: #e9eff7;
        color: #1f2937;
        border-bottom-left-radius: 4px;
    }

    .admin-typing {
        display: none;
        color: #6c757d;
        font-style: italic;
        margin-bottom: 15px;
    }

    .admin-chat-input {
        border-top: 1px solid #e5e7eb;
        background: white;
        padding: 18px;
    }

    .admin-chat-input textarea {
        resize: none;
    }

    .admin-suggestion {
        margin: 4px;
        border-radius: 20px;
    }

    .stat-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .05);
    }

    .conversation-table-card {
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .05);
    }

    @@media (max-width: 768px) {

        .admin-ai-header {
            padding: 20px;
        }

        .admin-chat-box {
            height: 450px;
            padding: 15px;
        }

        .admin-message-content {
            max-width: 90%;
        }
    }
</style>


<div class="admin-ai-page py-4">

    <div class="container-fluid">


        <!-- ================= HEADER ================= -->

        <div class="admin-ai-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2>
                        <i class="bi bi-stars me-2"></i>
                        Quản lý Travel AI
                    </h2>

                    <p>
                        Theo dõi hội thoại khách hàng và hỗ trợ
                        quản lý hệ thống bằng AI
                    </p>

                </div>

                <div class="d-none d-md-block">

                    <span class="ai-status">

                        <i class="bi bi-circle-fill text-success me-1"
                           style="font-size: 8px;"></i>

                        AI đang hoạt động

                    </span>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!--             TRỢ LÝ QUẢN LÝ THÔNG MINH            -->
        <!-- ================================================= -->

        <div class="card ai-chat-card mb-4">


            <!-- CHAT HEADER -->

            <div class="ai-chat-header">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5>

                            <i class="bi bi-robot me-2"></i>

                            Trợ lý quản lý thông minh

                        </h5>

                        <small>
                            Hỏi AI về dữ liệu và tình hình hoạt động
                            của hệ thống TravelAI
                        </small>

                    </div>

                    <span class="badge bg-light text-primary">

                        Admin AI

                    </span>

                </div>

            </div>


            <!-- CHAT BODY -->

            <div class="card-body p-0">

                <div id="adminChatBox"
                     class="admin-chat-box">


                    <!-- WELCOME -->

                    <div id="adminWelcome"
                         class="admin-welcome">

                        <div class="admin-welcome-icon">
                            🤖
                        </div>

                        <h4>
                            Xin chào Admin!
                        </h4>

                        <p class="text-muted">

                            Tôi có thể hỗ trợ bạn xem và phân tích
                            dữ liệu trong hệ thống TravelAI.

                        </p>


                        <!-- GỢI Ý -->

                        <div class="mt-4">

                            <button type="button"
                                    class="btn btn-outline-primary admin-suggestion"
                                    data-question="Hiện tại hệ thống có bao nhiêu người dùng?">

                                👥 Người dùng

                            </button>


                            <button type="button"
                                    class="btn btn-outline-primary admin-suggestion"
                                    data-question="Hiện tại có bao nhiêu tour, khách sạn và phòng?">

                                🏨 Tour / Hotel / Room

                            </button>


                            <button type="button"
                                    class="btn btn-outline-primary admin-suggestion"
                                    data-question="Hiện tại có bao nhiêu booking đang chờ, đã xác nhận và đã hủy?">

                                📋 Booking

                            </button>


                            <button type="button"
                                    class="btn btn-outline-primary admin-suggestion"
                                    data-question="Tổng doanh thu hiện tại của hệ thống là bao nhiêu?">

                                💰 Doanh thu

                            </button>


                            <button type="button"
                                    class="btn btn-outline-primary admin-suggestion"
                                    data-question="Hãy cho tôi biết tổng quan tình hình hệ thống TravelAI hiện tại.">

                                📊 Tổng quan

                            </button>

                        </div>

                    </div>


                    <!-- TYPING -->

                    <div id="adminTyping"
                         class="admin-typing">

                        🤖 AI đang phân tích dữ liệu...

                    </div>


                </div>


                <!-- ================= INPUT ================= -->

                <div class="admin-chat-input">

                    <div class="input-group">

                        <textarea id="adminMessageInput"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Ví dụ: Tổng doanh thu hiện tại là bao nhiêu?"></textarea>


                        <button id="adminSendButton"
                                type="button"
                                class="btn btn-primary px-4">

                            <i class="bi bi-send me-1"></i>

                            Gửi

                        </button>

                    </div>


                    <div class="small text-muted mt-2">

                        <i class="bi bi-info-circle me-1"></i>

                        AI sử dụng dữ liệu hiện có trong hệ thống
                        để hỗ trợ quản trị viên.

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= THỐNG KÊ ================= -->

        <div class="row g-3 mb-4">


            <!-- TOTAL CONVERSATIONS -->

            <div class="col-md-4">

                <div class="card stat-card h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Tổng cuộc hội thoại
                                </div>

                                <h3 class="fw-bold mb-0">
                                    @Model.Count()
                                </h3>

                            </div>

                            <div class="fs-2 text-primary">

                                <i class="bi bi-chat-dots"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- TOTAL MESSAGES -->

            <div class="col-md-4">

                <div class="card stat-card h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Tổng tin nhắn
                                </div>

                                <h3 class="fw-bold mb-0">

                                    @Model.Sum(
                                        c => c.Messages?.Count ?? 0
                                    )

                                </h3>

                            </div>

                            <div class="fs-2 text-success">

                                <i class="bi bi-chat-left-text"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- USERS USING AI -->

            <div class="col-md-4">

                <div class="card stat-card h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Người dùng sử dụng AI
                                </div>

                                <h3 class="fw-bold mb-0">

                                    @(Model
                                        .Where(c => c.UserId > 0)
                                        .Select(c => c.UserId)
                                        .Distinct()
                                        .Count())

                                </h3>

                            </div>

                            <div class="fs-2 text-warning">

                                <i class="bi bi-people"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= DANH SÁCH HỘI THOẠI ================= -->

        <div class="card conversation-table-card">


            <!-- TABLE HEADER -->

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-chat-square-text me-2"></i>

                        Danh sách hội thoại khách hàng

                    </h5>


                    <span class="badge bg-primary">

                        @Model.Count() cuộc hội thoại

                    </span>

                </div>

            </div>


            <!-- TABLE -->

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">


                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    ID
                                </th>

                                <th>
                                    Người dùng
                                </th>

                                <th>
                                    Tiêu đề
                                </th>

                                <th>
                                    Tin nhắn
                                </th>

                                <th>
                                    Ngày tạo
                                </th>

                                <th>
                                    Cập nhật
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.Any())
                            {

                                foreach (var conversation in Model)
                                {

                                    <tr>


                                        <!-- ID -->

                                        <td class="ps-4 fw-semibold">

                                            #@conversation.Id

                                        </td>


                                        <!-- USER -->

                                        <td>

                                            @if (conversation.User != null)
                                            {

                                                <div class="fw-semibold">

                                                    @conversation.User.FullName

                                                </div>

                                                <small class="text-muted">

                                                    @conversation.User.Email

                                                </small>

                                            }
                                            else
                                            {

                                                <span class="text-muted">

                                                    Không xác định

                                                </span>

                                            }

                                        </td>


                                        <!-- TITLE -->

                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(
                                                conversation.Title))
                                            {

                                                <span class="fw-semibold">

                                                    @conversation.Title

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="text-muted fst-italic">

                                                    Chưa có tiêu đề

                                                </span>

                                            }

                                        </td>


                                        <!-- MESSAGE COUNT -->

                                        <td>

                                            <span class="badge bg-primary-subtle text-primary">

                                                <i class="bi bi-chat me-1"></i>

                                                @(conversation.Messages?.Count ?? 0)

                                                tin nhắn

                                            </span>

                                        </td>


                                        <!-- CREATED -->

                                        <td>

                                            <small>

                                                @conversation.CreatedAt
                                                    .ToString("dd/MM/yyyy")

                                            </small>

                                            <br />

                                            <small class="text-muted">

                                                @conversation.CreatedAt
                                                    .ToString("HH:mm")

                                            </small>

                                        </td>


                                        <!-- UPDATED -->

                                        <td>

                                            <small>

                                                @conversation.UpdatedAt
                                                    .ToString("dd/MM/yyyy")

                                            </small>

                                            <br />

                                            <small class="text-muted">

                                                @conversation.UpdatedAt
                                                    .ToString("HH:mm")

                                            </small>

                                        </td>


                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="6"
                                        class="text-center py-5">

                                        <i class="bi bi-stars fs-1 text-muted"></i>

                                        <p class="text-muted mt-3 mb-0">

                                            Chưa có cuộc hội thoại AI nào.

                                        </p>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- JAVASCRIPT ADMIN AI                                       -->
<!-- ========================================================= -->

<script>

    const adminChatBox =
        document.getElementById("adminChatBox");

    const adminMessageInput =
        document.getElementById("adminMessageInput");

    const adminSendButton =
        document.getElementById("adminSendButton");

    const adminTyping =
        document.getElementById("adminTyping");


    // ================================
    // CUỘN CHAT XUỐNG CUỐI
    // ================================

    function scrollAdminChat()
    {
        if (!adminChatBox)
        {
            return;
        }

        adminChatBox.scrollTop =
            adminChatBox.scrollHeight;
    }


    // ================================
    // THÊM TIN NHẮN
    // ================================

    function addAdminMessage(content, role)
    {

        const message =
            document.createElement("div");


        message.className =
            role === "AI"
                ? "admin-message ai"
                : "admin-message user";


        const messageContent =
            document.createElement("div");


        messageContent.className =
            "admin-message-content";


        messageContent.textContent =
            content;


        message.appendChild(
            messageContent
        );


        adminChatBox.appendChild(
            message
        );


        scrollAdminChat();
    }


    // ================================
    // GỬI CÂU HỎI
    // ================================

    async function sendAdminMessage()
    {

        const message =
            adminMessageInput.value.trim();


        if (!message)
        {
            return;
        }


        // Xóa welcome

        const welcome =
            document.getElementById(
                "adminWelcome"
            );


        if (welcome)
        {
            welcome.remove();
        }


        // Hiển thị câu hỏi

        addAdminMessage(
            message,
            "User"
        );


        // Xóa ô nhập

        adminMessageInput.value = "";


        // Khóa nút

        adminSendButton.disabled =
            true;


        // Hiện trạng thái AI

        adminTyping.style.display =
            "block";


        scrollAdminChat();


        try
        {

            const response =
                await fetch(
                    '@Url.Action("Chat", "AdminAI")',
                    {
                        method: "POST",

                        headers:
                        {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body:
                            "message=" +
                            encodeURIComponent(message)
                    }
                );


            if (!response.ok)
            {

                throw new Error(
                    "Không thể kết nối tới Admin AI."
                );

            }


            const data =
                await response.json();


            if (data.success)
            {

                addAdminMessage(
                    data.message,
                    "AI"
                );

            }
            else
            {

                addAdminMessage(
                    data.message ||
                    "Có lỗi xảy ra.",
                    "AI"
                );

            }

        }
        catch (error)
        {

            console.error(error);


            addAdminMessage(
                "Xin lỗi, hiện tại không thể kết nối với Admin AI.",
                "AI"
            );

        }
        finally
        {

            adminTyping.style.display =
                "none";


            adminSendButton.disabled =
                false;


            adminMessageInput.focus();


            scrollAdminChat();

        }

    }


    // ================================
    // NÚT GỬI
    // ================================

    adminSendButton.addEventListener(
        "click",
        sendAdminMessage
    );


    // ================================
    // ENTER ĐỂ GỬI
    // SHIFT + ENTER = XUỐNG DÒNG
    // ================================

    adminMessageInput.addEventListener(
        "keydown",
        function(event)
        {

            if (
                event.key === "Enter" &&
                !event.shiftKey
            )
            {

                event.preventDefault();

                sendAdminMessage();

            }

        }
    );


    // ================================
    // CÂU HỎI GỢI Ý
    // ================================

    document
        .querySelectorAll(".admin-suggestion")
        .forEach(button =>
        {

            button.addEventListener(
                "click",
                function()
                {

                    adminMessageInput.value =
                        this.dataset.question;


                    sendAdminMessage();

                }
            );

        });


    // Cuộn xuống cuối khi mở trang

    scrollAdminChat();

</script>