@model IEnumerable<TravelAI.Models.AIConversation>

@{
    ViewData["Title"] = "Quản lý Travel AI";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-stars text-primary me-2"></i>
                Quản lý Travel AI
            </h2>

            <p class="text-muted mb-0">
                Theo dõi các cuộc hội thoại giữa khách hàng và Travel AI
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Về Dashboard

        </a>

    </div>


    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Tổng cuộc hội thoại
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.Count()
                            </h3>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="bi bi-chat-dots"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Tổng tin nhắn
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.Sum(c => c.Messages?.Count ?? 0)
                            </h3>
                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Người dùng sử dụng AI
                            </div>

                            <h3 class="fw-bold mb-0">
                                @(Model.Where(c => c.UserId > 0)
                                       .Select(c => c.UserId)
                                       .Distinct()
                                       .Count())
                            </h3>
                        </div>

                        <div class="fs-2 text-warning">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- DANH SÁCH HỘI THOẠI -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-chat-square-text me-2"></i>
                    Danh sách hội thoại
                </h5>

                <span class="badge bg-primary">
                    @Model.Count() cuộc hội thoại
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                ID
                            </th>

                            <th>
                                Người dùng
                            </th>

                            <th>
                                Tiêu đề
                            </th>

                            <th>
                                Tin nhắn
                            </th>

                            <th>
                                Ngày tạo
                            </th>

                            <th>
                                Cập nhật
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var conversation in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="ps-4 fw-semibold">
                                        #@conversation.Id
                                    </td>


                                    <!-- USER -->
                                    <td>

                                        @if (conversation.User != null)
                                        {
                                            <div class="fw-semibold">
                                                @conversation.User.FullName
                                            </div>

                                            <small class="text-muted">
                                                @conversation.User.Email
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Không xác định
                                            </span>
                                        }

                                    </td>


                                    <!-- TITLE -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(conversation.Title))
                                        {
                                            <span class="fw-semibold">
                                                @conversation.Title
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                Chưa có tiêu đề
                                            </span>
                                        }

                                    </td>


                                    <!-- MESSAGE COUNT -->
                                    <td>

                                        <span class="badge bg-primary-subtle text-primary">

                                            <i class="bi bi-chat me-1"></i>

                                            @(conversation.Messages?.Count ?? 0)

                                            tin nhắn

                                        </span>

                                    </td>


                                    <!-- CREATED -->
                                    <td>

                                        <small>
                                            @conversation.CreatedAt.ToString("dd/MM/yyyy")
                                        </small>

                                        <br />

                                        <small class="text-muted">
                                            @conversation.CreatedAt.ToString("HH:mm")
                                        </small>

                                    </td>


                                    <!-- UPDATED -->
                                    <td>

                                        <small>
                                            @conversation.UpdatedAt.ToString("dd/MM/yyyy")
                                        </small>

                                        <br />

                                        <small class="text-muted">
                                            @conversation.UpdatedAt.ToString("HH:mm")
                                        </small>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <i class="bi bi-stars fs-1 text-muted"></i>

                                    <p class="text-muted mt-3 mb-0">
                                        Chưa có cuộc hội thoại AI nào.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>