@model IEnumerable<TravelAI.Models.AIConversation>

@{
    ViewData["Title"] = "Trợ lý quản lý hệ thống AI";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        background: #f3f6fb;
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .admin-ai-page {
        height: calc(100vh - 90px);
        min-height: 650px;
        padding: 15px;
    }


    /* =========================================================
           MAIN CONTAINER
           ========================================================= */

    .ai-container {
        height: 100%;
        display: flex;
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5eaf2;
    }


    /* =========================================================
           LEFT SIDEBAR
           ========================================================= */

    .ai-sidebar {
        width: 310px;
        min-width: 310px;
        background: #ffffff;
        border-right: 1px solid #e5eaf2;
        display: flex;
        flex-direction: column;
    }


    .sidebar-header {
        padding: 20px;
        border-bottom: 1px solid #edf0f5;
    }


    .sidebar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
    }


    .sidebar-title-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }


    .sidebar-title h5 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #1f2937;
    }


    .sidebar-title small {
        display: block;
        color: #8a94a6;
        font-size: 12px;
        margin-top: 2px;
    }


    /* =========================================================
           NEW CHAT
           ========================================================= */

    .new-chat-btn {
        width: 100%;
        border: none;
        background: #0d6efd;
        color: white;
        padding: 11px 14px;
        border-radius: 9px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: 0.2s;
    }


        .new-chat-btn:hover {
            background: #0b5ed7;
            transform: translateY(-1px);
        }


    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .quick-actions {
        padding: 15px 12px 10px;
        border-bottom: 1px solid #edf0f5;
    }


    .quick-title {
        padding: 0 8px 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        color: #8a94a6;
    }


    .quick-action {
        width: 100%;
        border: none;
        background: transparent;
        padding: 10px 9px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: left;
        color: #374151;
        font-size: 13px;
        transition: 0.2s;
        margin-bottom: 2px;
        cursor: pointer;
    }


        .quick-action:hover {
            background: #f1f5ff;
            color: #0d6efd;
        }


    .quick-action-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f3f6fa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #5f6b7a;
        flex-shrink: 0;
    }


    .quick-action:hover .quick-action-icon {
        background: #e7f0ff;
        color: #0d6efd;
    }


    .quick-action-text {
        flex: 1;
    }


    /* =========================================================
           HISTORY
           ========================================================= */

    .history-header {
        padding: 14px 16px 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        color: #8a94a6;
    }


    .conversation-list {
        flex: 1;
        overflow-y: auto;
    }


    .conversation-item {
        display: block;
        padding: 12px 16px;
        border-left: 3px solid transparent;
        border-bottom: 1px solid #f1f3f6;
        text-decoration: none;
        color: #374151;
        transition: 0.2s;
        cursor: pointer;
    }


        .conversation-item:hover {
            background: #f7f9fc;
            color: #111827;
        }


        .conversation-item.active {
            background: #edf4ff;
            border-left-color: #0d6efd;
        }


    .conversation-title {
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 5px;
    }


        .conversation-title i {
            color: #64748b;
        }


    .conversation-meta {
        font-size: 11px;
        color: #9aa3b2;
    }


    .empty-history {
        padding: 25px 15px;
        text-align: center;
        color: #9aa3b2;
        font-size: 13px;
    }


    /* =========================================================
           RIGHT CHAT
           ========================================================= */

    .ai-chat-area {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
    }


    /* =========================================================
           CHAT HEADER
           ========================================================= */

    .chat-header {
        min-height: 70px;
        background: linear-gradient(135deg, #0d6efd, #2563eb);
        color: white;
        padding: 14px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }


    .ai-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }


    .chat-header h5 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 650px;
    }


    .chat-header small {
        display: block;
        margin-top: 2px;
        opacity: 0.85;
        font-size: 11px;
    }


    .ai-status {
        font-size: 11px;
        padding: 6px 10px;
        border-radius: 20px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        white-space: nowrap;
    }


    /* =========================================================
           CHAT MESSAGES
           ========================================================= */

    .chat-messages {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        padding: 25px 30px;
        display: flex;
        flex-direction: column;
        /*
             * Không dùng gap quá lớn.
             * Câu hỏi và câu trả lời sẽ nằm gần nhau.
             */
        gap: 8px;
        box-sizing: border-box;
    }


    /* =========================================================
           WELCOME
           ========================================================= */

    .welcome-message {
        margin: auto;
        text-align: center;
        max-width: 520px;
        color: #6b7280;
    }


    .welcome-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 15px;
    }


    .welcome-message h4 {
        color: #1f2937;
        font-weight: 700;
        margin-bottom: 8px;
    }


    .welcome-message p {
        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================================================
           MESSAGE ROW
           ========================================================= */

    /*
         * QUAN TRỌNG:
         *
         * Không để width:100%.
         * Không để flex:0 0 100%.
         *
         * Mỗi message chỉ chiếm chiều rộng cần thiết.
         * Nhờ vậy khoảng cách giữa câu hỏi và câu trả lời
         * nhìn tự nhiên hơn.
         */

    .message-row {
        display: flex;
        width: auto;
        max-width: 78%;
        flex: 0 0 auto;
        box-sizing: border-box;
    }


        /* USER */

        .message-row.user {
            align-self: flex-end;
            justify-content: flex-end;
        }


        /* ASSISTANT */

        .message-row.assistant {
            align-self: flex-start;
            justify-content: flex-start;
        }


    /* =========================================================
           MESSAGE CONTENT
           ========================================================= */

    .message-content {
        display: flex;
        flex-direction: column;
        max-width: 100%;
    }


    /* =========================================================
           MESSAGE BUBBLE
           ========================================================= */

    .message-bubble {
        width: fit-content;
        max-width: 100%;
        padding: 11px 14px;
        border-radius: 14px;
        font-size: 13px;
        line-height: 1.55;
        white-space: pre-wrap;
        word-break: break-word;
        box-sizing: border-box;
    }


    /* =========================================================
           USER MESSAGE
           ========================================================= */

    .message-row.user .message-bubble {
        margin-left: auto;
        background: #0d6efd;
        color: white;
        border-bottom-right-radius: 4px;
    }


    /* =========================================================
           ASSISTANT MESSAGE
           ========================================================= */

    .message-row.assistant .message-bubble {
        margin-right: auto;
        background: white;
        color: #263244;
        border: 1px solid #e5eaf0;
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 7px rgba(0,0,0,0.03);
    }


    /* =========================================================
           TIME
           ========================================================= */

    .message-time {
        font-size: 10px;
        color: #9aa3b2;
        margin-top: 3px;
        line-height: 1.2;
    }


    .message-row.user .message-time {
        text-align: right;
    }


    .message-row.assistant .message-time {
        text-align: left;
    }


    /* =========================================================
           TYPING
           ========================================================= */

    .typing {
        display: none;
        padding: 0 30px 8px;
    }


    .typing-bubble {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: white;
        border: 1px solid #e5eaf0;
        padding: 9px 12px;
        border-radius: 12px;
        box-shadow: 0 2px 7px rgba(0,0,0,0.03);
    }


    .typing-dot {
        width: 6px;
        height: 6px;
        background: #8b95a5;
        border-radius: 50%;
        animation: typingAnimation 1.2s infinite;
    }


        .typing-dot:nth-child(2) {
            animation-delay: 0.15s;
        }


        .typing-dot:nth-child(3) {
            animation-delay: 0.3s;
        }


    @@keyframes typingAnimation {

        0%, 60%, 100% {
            opacity: 0.3;
            transform: translateY(0);
        }

        30% {
            opacity: 1;
            transform: translateY(-3px);
        }
    }


    /* =========================================================
           CHAT INPUT
           ========================================================= */

    .chat-input-area {
        background: white;
        border-top: 1px solid #e5eaf0;
        padding: 14px 18px;
    }


    .chat-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }


    .chat-input {
        flex: 1;
        resize: none;
        min-height: 48px;
        max-height: 120px;
        border: 1px solid #dce2ea;
        border-radius: 10px;
        padding: 13px 14px;
        font-size: 13px;
        outline: none;
    }


        .chat-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.08);
        }


    .send-button {
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: 0.2s;
        flex-shrink: 0;
    }


        .send-button:hover {
            background: #0b5ed7;
        }


        .send-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }


    .chat-hint {
        margin-top: 7px;
        font-size: 10px;
        color: #9aa3b2;
    }


    /* =========================================================
           SCROLLBAR
           ========================================================= */

    .conversation-list::-webkit-scrollbar,
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }


    .conversation-list::-webkit-scrollbar-thumb,
    .chat-messages::-webkit-scrollbar-thumb {
        background: #cbd2dc;
        border-radius: 10px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .ai-sidebar {
            width: 250px;
            min-width: 250px;
        }

        .message-row {
            max-width: 85%;
        }
    }


    @@media (max-width: 700px) {

        .admin-ai-page {
            height: auto;
            min-height: calc(100vh - 90px);
            padding: 8px;
        }

        .ai-container {
            min-height: 700px;
        }

        .ai-sidebar {
            width: 220px;
            min-width: 220px;
        }

        .quick-action-text {
            font-size: 12px;
        }

        .chat-messages {
            padding: 18px;
        }

        .message-row {
            max-width: 90%;
        }

        .ai-status {
            display: none;
        }
    }

</style>


<div class="admin-ai-page">

    <div class="ai-container">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="ai-sidebar">

            <!-- HEADER -->

            <div class="sidebar-header">

                <div class="sidebar-title">

                    <div class="sidebar-title-icon">
                        <i class="bi bi-robot"></i>
                    </div>

                    <div>

                        <h5>
                            Trợ lý AI quản trị
                        </h5>

                        <small>
                            Hỗ trợ quản lý TravelAI
                        </small>

                    </div>

                </div>


                <button type="button"
                        id="newConversationButton"
                        class="new-chat-btn">

                    <i class="bi bi-plus-lg"></i>

                    Đoạn chat mới

                </button>

            </div>


            <!-- ================================================= -->
            <!-- CHỨC NĂNG NHANH -->
            <!-- ================================================= -->

            <div class="quick-actions">

                <div class="quick-title">
                    Chức năng nhanh
                </div>


                <!-- TỔNG HỢP -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Hãy tổng hợp tình hình hệ thống TravelAI hiện tại gồm người dùng, tour, khách sạn, phòng, booking và doanh thu.')">

                    <span class="quick-action-icon">
                        <i class="bi bi-grid-1x2"></i>
                    </span>

                    <span class="quick-action-text">
                        Tổng hợp hệ thống
                    </span>

                </button>


                <!-- BOOKING -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Hiện tại hệ thống có bao nhiêu booking? Hãy thống kê booking theo trạng thái.')">

                    <span class="quick-action-icon">
                        <i class="bi bi-bar-chart"></i>
                    </span>

                    <span class="quick-action-text">
                        Thống kê booking
                    </span>

                </button>


                <!-- DOANH THU -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Tổng doanh thu hiện tại của hệ thống là bao nhiêu?')">

                    <span class="quick-action-icon">
                        <i class="bi bi-cash-stack"></i>
                    </span>

                    <span class="quick-action-text">
                        Báo cáo doanh thu
                    </span>

                </button>


                <!-- USER -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Hiện tại hệ thống có bao nhiêu người dùng?')">

                    <span class="quick-action-icon">
                        <i class="bi bi-people"></i>
                    </span>

                    <span class="quick-action-text">
                        Thống kê người dùng
                    </span>

                </button>


                <!-- TOUR -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Hiện tại hệ thống có bao nhiêu tour?')">

                    <span class="quick-action-icon">
                        <i class="bi bi-map"></i>
                    </span>

                    <span class="quick-action-text">
                        Thống kê tour
                    </span>

                </button>


                <!-- HOTEL -->

                <button type="button"
                        class="quick-action"
                        onclick="askQuickQuestion('Hiện tại hệ thống có bao nhiêu khách sạn và bao nhiêu phòng?')">

                    <span class="quick-action-icon">
                        <i class="bi bi-building"></i>
                    </span>

                    <span class="quick-action-text">
                        Khách sạn & phòng
                    </span>

                </button>

            </div>


            <!-- ================================================= -->
            <!-- LỊCH SỬ -->
            <!-- ================================================= -->

            <div class="history-header">
                Lịch sử hội thoại
            </div>


            <div class="conversation-list"
                 id="conversationList">

                @if (Model != null &&
                    Model.Any(x =>
                        x.Messages != null &&
                        x.Messages.Any()))
                {
                    foreach (var conversation in Model
                        .Where(x =>
                            x.Messages != null &&
                            x.Messages.Any())
                        .OrderByDescending(x => x.UpdatedAt))
                    {
                        <div class="conversation-item"
                             data-conversation-id="@conversation.Id"
                             onclick="selectConversation(@conversation.Id, this)">

                            <div class="conversation-title">

                                <i class="bi bi-chat-left-text me-1"></i>

                                @(string.IsNullOrWhiteSpace(conversation.Title)
                                    ? "Cuộc trò chuyện"
                                    : conversation.Title)

                            </div>


                            <div class="conversation-meta">

                                @(conversation.Messages?.Count ?? 0) tin nhắn

                                <span class="mx-1">
                                    •
                                </span>

                                @conversation.UpdatedAt.ToString(
                                    "dd/MM/yyyy HH:mm")

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-history">

                        <i class="bi bi-chat-square-text"
                           style="font-size:25px;">
                        </i>

                        <div class="mt-2">
                            Chưa có cuộc trò chuyện
                        </div>

                    </div>
                }

            </div>

        </aside>


        <!-- ================================================= -->
        <!-- CHAT AREA -->
        <!-- ================================================= -->

        <main class="ai-chat-area">

            <!-- HEADER -->

            <div class="chat-header">

                <div class="chat-header-left">

                    <div class="ai-avatar">

                        <i class="bi bi-stars"></i>

                    </div>


                    <div>

                        <h5 id="currentConversationTitle">
                            Cuộc trò chuyện mới
                        </h5>

                        <small>
                            Tra cứu dữ liệu và hỗ trợ quản lý TravelAI
                        </small>

                    </div>

                </div>


                <div class="ai-status">

                    <i class="bi bi-circle-fill text-success me-1"></i>

                    AI đang hoạt động

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MESSAGE AREA -->
            <!-- ================================================= -->

            <div class="chat-messages"
                 id="adminChatBox">

                <div class="welcome-message">

                    <div class="welcome-icon">

                        <i class="bi bi-robot"></i>

                    </div>


                    <h4>
                        Xin chào, Quản trị viên!
                    </h4>


                    <p>
                        Tôi có thể hỗ trợ bạn tra cứu dữ liệu
                        và thống kê hệ thống TravelAI.
                    </p>


                    <p class="mb-0">
                        Hãy chọn một chức năng bên trái
                        hoặc nhập câu hỏi bên dưới.
                    </p>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- TYPING -->
            <!-- ================================================= -->

            <div id="adminTyping"
                 class="typing">

                <div class="typing-bubble">

                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- INPUT -->
            <!-- ================================================= -->

            <div class="chat-input-area">

                <div class="chat-input-wrapper">

                    <textarea id="adminMessageInput"
                              class="chat-input"
                              placeholder="Nhập câu hỏi cho trợ lý quản lý hệ thống..."
                              rows="1"></textarea>


                    <button type="button"
                            id="adminSendButton"
                            class="send-button">

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>


                <div class="chat-hint">

                    <i class="bi bi-info-circle me-1"></i>

                    AI sử dụng dữ liệu thực tế trong hệ thống
                    để trả lời quản trị viên.

                </div>

            </div>

        </main>

    </div>

</div>


<script>

    // =========================================================
    // BIẾN
    // =========================================================

    let currentConversationId = null;


    const adminChatBox =
        document.getElementById("adminChatBox");


    const adminMessageInput =
        document.getElementById("adminMessageInput");


    const adminSendButton =
        document.getElementById("adminSendButton");


    const newConversationButton =
        document.getElementById(
            "newConversationButton"
        );


    const adminTyping =
        document.getElementById("adminTyping");


    // =========================================================
    // CLEAR CHAT
    // =========================================================

    function clearChatBox() {

        adminChatBox.innerHTML = "";

    }


    // =========================================================
    // WELCOME
    // =========================================================

    function showWelcomeMessage() {

        adminChatBox.innerHTML = `

            <div class="welcome-message">

                <div class="welcome-icon">
                    <i class="bi bi-robot"></i>
                </div>

                <h4>
                    Xin chào, Quản trị viên!
                </h4>

                <p>
                    Tôi có thể hỗ trợ bạn tra cứu dữ liệu
                    và thống kê hệ thống TravelAI.
                </p>

                <p class="mb-0">
                    Hãy chọn một chức năng bên trái
                    hoặc nhập câu hỏi bên dưới.
                </p>

            </div>

        `;

    }


    // =========================================================
    // FORMAT TIME
    // =========================================================

    function formatTime(dateString) {

        if (!dateString) {
            return "";
        }


        const date =
            new Date(dateString);


        return date.toLocaleString(
            "vi-VN",
            {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    }


    // =========================================================
    // ADD MESSAGE
    // =========================================================

    function addMessage(
        role,
        content,
        createdAt = null
    ) {

        const row =
            document.createElement("div");


        row.className =
            "message-row " +
            (
                role === "User"
                    ? "user"
                    : "assistant"
            );


        const contentWrapper =
            document.createElement("div");


        contentWrapper.className =
            "message-content";


        const bubble =
            document.createElement("div");


        bubble.className =
            "message-bubble";


        bubble.textContent =
            content;


        contentWrapper.appendChild(
            bubble
        );


        if (createdAt) {

            const time =
                document.createElement("div");


            time.className =
                "message-time";


            time.textContent =
                formatTime(createdAt);


            contentWrapper.appendChild(
                time
            );
        }


        row.appendChild(
            contentWrapper
        );


        adminChatBox.appendChild(
            row
        );


        // Cuộn xuống cuối
        requestAnimationFrame(
            () => {

                adminChatBox.scrollTop =
                    adminChatBox.scrollHeight;

            }
        );

    }


    // =========================================================
    // SELECT CONVERSATION
    // =========================================================

    async function selectConversation(
        conversationId,
        element
    ) {

        currentConversationId =
            parseInt(conversationId);


        // Active item
        document
            .querySelectorAll(
                ".conversation-item"
            )
            .forEach(item => {

                item.classList.remove(
                    "active"
                );

            });


        if (element) {

            element.classList.add(
                "active"
            );

        }


        try {

            clearChatBox();


            const response =
                await fetch(
                    '@Url.Action("GetMessages", "AdminAI")?conversationId='
                    + conversationId
                );


            const data =
                await response.json();


            if (!data.success) {

                alert(
                    data.message ||
                    "Không thể tải lịch sử hội thoại."
                );

                showWelcomeMessage();

                return;
            }


            document
                .getElementById(
                    "currentConversationTitle"
                )
                .textContent =
                    data.title ||
                    "Cuộc trò chuyện";


            if (
                data.messages &&
                data.messages.length > 0
            ) {

                data.messages.forEach(
                    message => {

                        addMessage(
                            message.role,
                            message.content,
                            message.createdAt
                        );

                    }
                );

            }
            else {

                showWelcomeMessage();

            }

        }
        catch (error) {

            console.error(error);

            showWelcomeMessage();

            alert(
                "Không thể tải lịch sử hội thoại."
            );

        }

    }


    // =========================================================
    // NEW CONVERSATION
    // =========================================================

    async function createNewConversation() {

        try {

            const response =
                await fetch(
                    '@Url.Action("NewConversation", "AdminAI")',
                    {
                        method: "POST"
                    }
                );


            const data =
                await response.json();


            if (!data.success) {

                alert(
                    data.message ||
                    "Không thể tạo cuộc trò chuyện mới."
                );

                return;
            }


            // Quan trọng:
            // Conversation chưa được lưu DB
            currentConversationId = null;


            // Bỏ active ở lịch sử
            document
                .querySelectorAll(
                    ".conversation-item"
                )
                .forEach(item => {

                    item.classList.remove(
                        "active"
                    );

                });


            // Đổi tiêu đề
            document
                .getElementById(
                    "currentConversationTitle"
                )
                .textContent =
                    "Cuộc trò chuyện mới";


            // Xóa tin nhắn cũ
            clearChatBox();


            // Hiện màn hình chào
            showWelcomeMessage();


            // Xóa ô nhập
            adminMessageInput.value = "";


            // Focus
            adminMessageInput.focus();

        }
        catch (error) {

            console.error(error);

            alert(
                "Không thể tạo cuộc trò chuyện mới."
            );

        }

    }


    // =========================================================
    // SEND MESSAGE
    // =========================================================

    async function sendAdminMessage() {

        const message =
            adminMessageInput.value.trim();


        if (!message) {
            return;
        }


        // Nếu đang hiện welcome
        // thì xóa welcome trước
        const welcome =
            adminChatBox.querySelector(
                ".welcome-message"
            );


        if (welcome) {

            clearChatBox();

        }


        // Hiển thị câu hỏi ngay lập tức
        addMessage(
            "User",
            message,
            new Date().toISOString()
        );


        // Xóa input
        adminMessageInput.value = "";


        // Hiện typing
        adminTyping.style.display =
            "block";


        // Disable nút
        adminSendButton.disabled =
            true;


        try {

            const formData =
                new URLSearchParams();


            formData.append(
                "message",
                message
            );


            if (currentConversationId) {

                formData.append(
                    "conversationId",
                    currentConversationId
                );

            }


            const response =
                await fetch(
                    '@Url.Action("Chat", "AdminAI")',
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body:
                            formData
                    }
                );


            const data =
                await response.json();


            if (!data.success) {

                addMessage(
                    "Assistant",
                    data.message ||
                    "AI không thể trả lời."
                );

                return;
            }


            // Nhận ID conversation
            currentConversationId =
                data.conversationId;


            // Cập nhật tiêu đề
            document
                .getElementById(
                    "currentConversationTitle"
                )
                .textContent =
                    data.title ||
                    "Cuộc trò chuyện";


            // Thêm câu trả lời AI
            addMessage(
                "Assistant",
                data.message,
                data.createdAt ||
                new Date().toISOString()
            );


            // Cập nhật lịch sử bên trái
            await refreshConversationList();


        }
        catch (error) {

            console.error(error);

            addMessage(
                "Assistant",
                "Đã xảy ra lỗi khi kết nối với AI."
            );

        }
        finally {

            adminTyping.style.display =
                "none";


            adminSendButton.disabled =
                false;


            adminMessageInput.focus();

        }

    }


    // =========================================================
    // QUICK QUESTION
    // =========================================================

    function askQuickQuestion(question) {

        // Nếu chưa có conversation
        // thì đây sẽ là conversation mới.
        //
        // Không cần tạo DB trước.

        adminMessageInput.value =
            question;


        adminMessageInput.focus();


        sendAdminMessage();

    }


    // =========================================================
    // REFRESH HISTORY
    // =========================================================

    async function refreshConversationList() {

        try {

            const response =
                await fetch(
                    '@Url.Action("Index", "AdminAI")'
                );


            if (!response.ok) {
                return;
            }


            const html =
                await response.text();


            const parser =
                new DOMParser();


            const documentHtml =
                parser.parseFromString(
                    html,
                    "text/html"
                );


            const newList =
                documentHtml.getElementById(
                    "conversationList"
                );


            if (!newList) {
                return;
            }


            const currentList =
                document.getElementById(
                    "conversationList"
                );


            currentList.innerHTML =
                newList.innerHTML;


            // Active conversation hiện tại
            if (currentConversationId) {

                const currentItem =
                    currentList.querySelector(
                        `[data-conversation-id="${currentConversationId}"]`
                    );


                if (currentItem) {

                    currentItem.classList.add(
                        "active"
                    );

                }

            }

        }
        catch (error) {

            console.error(
                "Không thể cập nhật lịch sử:",
                error
            );

        }

    }


    // =========================================================
    // EVENTS
    // =========================================================

    newConversationButton
        .addEventListener(
            "click",
            createNewConversation
        );


    adminSendButton
        .addEventListener(
            "click",
            sendAdminMessage
        );


    adminMessageInput
        .addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Enter" &&
                    !event.shiftKey
                ) {

                    event.preventDefault();

                    sendAdminMessage();

                }

            }
        );


    // =========================================================
    // AUTO LOAD FIRST CONVERSATION
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const firstConversation =
                document.querySelector(
                    ".conversation-item"
                );


            if (firstConversation) {

                const id =
                    firstConversation
                        .getAttribute(
                            "data-conversation-id"
                        );


                selectConversation(
                    id,
                    firstConversation
                );

            }

        }
    );

</script>