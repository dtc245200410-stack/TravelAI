@model IEnumerable<TravelAI.Models.Room>

@{
    ViewData["Title"] = "Quản lý phòng";

    var hotels = ViewBag.Hotels as IEnumerable<TravelAI.Models.Hotel>
                  ?? Enumerable.Empty<TravelAI.Models.Hotel>();

    var searchString = ViewBag.SearchString as string;
    var selectedStatus = ViewBag.Status as string ?? "All";
    var selectedHotelId = ViewBag.HotelId as int?;
}

<div class="admin-page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a asp-controller="Admin" asp-action="Index">
                    Dashboard
                </a>
                <span>/</span>
                <span>Phòng</span>
            </div>

            <h1>
                <i class="bi bi-door-open"></i>
                Quản lý phòng
            </h1>

            <p class="page-description">
                Quản lý danh sách phòng của các khách sạn trong hệ thống.
            </p>
        </div>

        <a asp-action="Create" class="btn-add">
            <i class="bi bi-plus-lg"></i>
            Thêm phòng
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="alert-close"
                    onclick="this.parentElement.remove()">
                &times;
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="alert-close"
                    onclick="this.parentElement.remove()">
                &times;
            </button>
        </div>
    }

    <!-- BỘ LỌC -->
    <div class="filter-card">

        <form asp-action="Index" method="get">

            <div class="filter-grid">

                <!-- SEARCH -->
                <div class="filter-item search-item">
                    <label>Tìm kiếm</label>

                    <div class="search-box">
                        <i class="bi bi-search"></i>

                        <input type="text"
                               name="searchString"
                               value="@searchString"
                               placeholder="Tên phòng, loại phòng hoặc khách sạn..." />
                    </div>
                </div>

                <!-- HOTEL -->
                <div class="filter-item">
                    <label>Khách sạn</label>

                    <select name="hotelId">
                        <option value="">-- Tất cả khách sạn --</option>

                        @foreach (var hotel in hotels)
                        {
                            if (selectedHotelId.HasValue &&
                                selectedHotelId.Value == hotel.Id)
                            {
                                <option value="@hotel.Id" selected>
                                    @hotel.Name
                                </option>
                            }
                            else
                            {
                                <option value="@hotel.Id">
                                    @hotel.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- STATUS -->
                <div class="filter-item">
                    <label>Trạng thái</label>

                    <select name="status">

                        @if (selectedStatus == "All")
                        {
                            <option value="All" selected>
                                Tất cả
                            </option>
                        }
                        else
                        {
                            <option value="All">
                                Tất cả
                            </option>
                        }

                        @if (selectedStatus == "Available")
                        {
                            <option value="Available" selected>
                                Đang hoạt động
                            </option>
                        }
                        else
                        {
                            <option value="Available">
                                Đang hoạt động
                            </option>
                        }

                        @if (selectedStatus == "Unavailable")
                        {
                            <option value="Unavailable" selected>
                                Tạm ngưng
                            </option>
                        }
                        else
                        {
                            <option value="Unavailable">
                                Tạm ngưng
                            </option>
                        }

                    </select>
                </div>

                <!-- BUTTON -->
                <div class="filter-actions">

                    <button type="submit" class="btn-filter">
                        <i class="bi bi-funnel"></i>
                        Lọc
                    </button>

                    <a asp-action="Index" class="btn-reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Đặt lại
                    </a>

                </div>

            </div>

        </form>

    </div>

    <!-- TABLE CARD -->
    <div class="table-card">

        <div class="table-header">

            <div>
                <h2>Danh sách phòng</h2>

                <span class="result-count">
                    Có <strong>@Model.Count()</strong> phòng
                </span>
            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-door-closed"></i>
                </div>

                <h3>Không tìm thấy phòng</h3>

                <p>
                    Chưa có phòng phù hợp với điều kiện tìm kiếm.
                </p>

                <a asp-action="Create" class="btn-add">
                    <i class="bi bi-plus-lg"></i>
                    Thêm phòng
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="admin-table">

                    <thead>
                        <tr>
                            <th style="width: 60px;">STT</th>
                            <th>Phòng</th>
                            <th>Khách sạn</th>
                            <th>Loại phòng</th>
                            <th>Sức chứa</th>
                            <th>Giá / đêm</th>
                            <th>Số lượng</th>
                            <th>Còn trống</th>
                            <th>Trạng thái</th>
                            <th style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var index = 1;
                        }

                        @foreach (var room in Model)
                        {
                            <tr>

                                <!-- STT -->
                                <td class="text-center">
                                    @index
                                </td>

                                <!-- ROOM -->
                                <td>

                                    <div class="room-info">

                                        @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                                        {
                                            <img src="@room.ImageUrl"
                                                 alt="@room.RoomName"
                                                 class="room-image"
                                                 onerror="this.style.display='none';" />
                                        }
                                        else
                                        {
                                            <div class="room-image-placeholder">
                                                <i class="bi bi-door-open"></i>
                                            </div>
                                        }

                                        <div>
                                            <div class="room-name">
                                                @room.RoomName
                                            </div>

                                            <div class="room-id">
                                                ID: #@room.Id
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <!-- HOTEL -->
                                <td>

                                    @if (room.Hotel != null)
                                    {
                                        <a asp-controller="AdminHotel"
                                           asp-action="Details"
                                           asp-route-id="@room.HotelId"
                                           class="hotel-link">
                                            <i class="bi bi-building"></i>
                                            @room.Hotel.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Không xác định
                                        </span>
                                    }

                                </td>

                                <!-- TYPE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(room.RoomType))
                                    {
                                        <span class="type-badge">
                                            @room.RoomType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>

                                <!-- GUESTS -->
                                <td>
                                    <span class="guest-count">
                                        <i class="bi bi-people"></i>
                                        @room.MaxGuests người
                                    </span>
                                </td>

                                <!-- PRICE -->
                                <td>
                                    <strong class="price">
                                        @room.PricePerNight.ToString("N0")
                                        <small>đ</small>
                                    </strong>
                                </td>

                                <!-- QUANTITY -->
                                <td class="text-center">
                                    @room.Quantity
                                </td>

                                <!-- AVAILABLE -->
                                <td class="text-center">

                                    @if (room.AvailableQuantity > 0)
                                    {
                                        <span class="available">
                                            @room.AvailableQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="sold-out">
                                            0
                                        </span>
                                    }

                                </td>

                                <!-- STATUS -->
                                <td>

                                    @if (room.Status == "Available")
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-pause-circle-fill"></i>
                                            Tạm ngưng
                                        </span>
                                    }

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@room.Id"
                                           class="action-btn btn-view"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@room.Id"
                                           class="action-btn btn-edit"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@room.Id"
                                           class="action-btn btn-delete"
                                           title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                        @if (room.Status == "Available")
                                        {
                                            <form asp-action="ChangeStatus"
                                                  method="post"
                                                  class="status-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@room.Id" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Unavailable" />

                                                <button type="submit"
                                                        class="action-btn btn-pause"
                                                        title="Tạm ngưng"
                                                        onclick="return confirm('Bạn có chắc muốn tạm ngưng phòng này?');">
                                                    <i class="bi bi-pause"></i>
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ChangeStatus"
                                                  method="post"
                                                  class="status-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@room.Id" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Available" />

                                                <button type="submit"
                                                        class="action-btn btn-active"
                                                        title="Kích hoạt"
                                                        onclick="return confirm('Bạn có chắc muốn kích hoạt phòng này?');">
                                                    <i class="bi bi-play"></i>
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<style>

    .admin-page {
        padding: 30px;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #8a94a6;
        margin-bottom: 10px;
    }

        .breadcrumb a {
            color: #667eea;
            text-decoration: none;
        }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
    }

        .page-header h1 i {
            margin-right: 10px;
        }

    .page-description {
        margin: 8px 0 0;
        color: #7b8494;
        font-size: 15px;
    }

    /* BUTTON */

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 9px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: 0.2s;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #5568d8;
            color: white;
            transform: translateY(-1px);
        }

    /* ALERT */

    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #ecfdf3;
        color: #087443;
        border: 1px solid #b7ebcd;
    }

    .alert-danger {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    .alert-close {
        margin-left: auto;
        border: none;
        background: transparent;
        font-size: 22px;
        cursor: pointer;
    }

    /* FILTER */

    .filter-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 22px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(300px, 1.8fr) 1fr 1fr auto;
        gap: 15px;
        align-items: end;
    }

    .filter-item label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 7px;
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

        .search-box input,
        .filter-item select {
            width: 100%;
            height: 43px;
            border: 1px solid #e1e5eb;
            border-radius: 8px;
            padding: 0 13px;
            outline: none;
            background: white;
            color: #374151;
            font-size: 14px;
        }

        .search-box input {
            padding-left: 38px;
        }

            .search-box input:focus,
            .filter-item select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

    .filter-actions {
        display: flex;
        gap: 8px;
    }

    .btn-filter,
    .btn-reset {
        height: 43px;
        padding: 0 15px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-filter {
        border: none;
        background: #667eea;
        color: white;
    }

        .btn-filter:hover {
            background: #5568d8;
        }

    .btn-reset {
        border: 1px solid #e1e5eb;
        background: white;
        color: #4b5563;
    }

        .btn-reset:hover {
            background: #f8fafc;
            color: #374151;
        }

    /* TABLE */

    .table-card {
        background: white;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .table-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f3;
    }

        .table-header h2 {
            margin: 0;
            font-size: 19px;
            color: #1f2937;
        }

    .result-count {
        display: inline-block;
        margin-top: 5px;
        font-size: 13px;
        color: #8a94a6;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1200px;
    }

        .admin-table thead {
            background: #f8fafc;
        }

        .admin-table th {
            padding: 14px 12px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            border-bottom: 1px solid #e8ecf0;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #edf0f3;
            color: #374151;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tbody tr {
            transition: 0.15s;
        }

            .admin-table tbody tr:hover {
                background: #fafbff;
            }

    .text-center {
        text-align: center !important;
    }

    .text-muted {
        color: #9ca3af;
    }

    /* ROOM */

    .room-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 210px;
    }

    .room-image,
    .room-image-placeholder {
        width: 58px;
        height: 45px;
        border-radius: 7px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .room-image-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #667eea;
        font-size: 20px;
    }

    .room-name {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 3px;
    }

    .room-id {
        font-size: 11px;
        color: #9ca3af;
    }

    .hotel-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
    }

        .hotel-link:hover {
            text-decoration: underline;
        }

    .type-badge {
        display: inline-block;
        padding: 5px 9px;
        background: #f3f4f6;
        color: #4b5563;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .guest-count {
        white-space: nowrap;
    }

        .guest-count i {
            color: #667eea;
            margin-right: 4px;
        }

    .price {
        color: #111827;
        white-space: nowrap;
    }

        .price small {
            font-size: 11px;
            font-weight: 500;
        }

    .available {
        color: #059669;
        font-weight: 700;
    }

    .sold-out {
        color: #dc2626;
        font-weight: 700;
    }

    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #ecfdf5;
        color: #047857;
    }

    .status-inactive {
        background: #fff7ed;
        color: #c2410c;
    }

    /* ACTIONS */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        transition: 0.15s;
        font-size: 14px;
    }

    .btn-view {
        background: #eef2ff;
        color: #4f46e5;
    }

        .btn-view:hover {
            background: #e0e7ff;
        }

    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-edit:hover {
            background: #dbeafe;
        }

    .btn-delete {
        background: #fff1f2;
        color: #e11d48;
    }

        .btn-delete:hover {
            background: #ffe4e6;
        }

    .btn-pause {
        background: #fff7ed;
        color: #ea580c;
    }

        .btn-pause:hover {
            background: #ffedd5;
        }

    .btn-active {
        background: #ecfdf5;
        color: #059669;
    }

        .btn-active:hover {
            background: #d1fae5;
        }

    .status-form {
        margin: 0;
        padding: 0;
    }

    /* EMPTY */

    .empty-state {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #667eea;
        font-size: 28px;
    }

    .empty-state h3 {
        margin: 0 0 7px;
        color: #374151;
    }

    .empty-state p {
        margin: 0 0 20px;
        color: #9ca3af;
    }

    /* RESPONSIVE */

    @@media (max-width: 1100px) {

        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .search-item {
            grid-column: 1 / -1;
        }

        .filter-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 700px) {

        .admin-page {
            padding: 18px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-add {
            justify-content: center;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .search-item {
            grid-column: auto;
        }

        .filter-actions {
            width: 100%;
        }

        .btn-filter,
        .btn-reset {
            flex: 1;
        }
    }

</style>