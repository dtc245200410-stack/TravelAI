@model TravelAI.Models.Room

@{
    ViewData["Title"] = "Thêm phòng";

    var hotels = ViewBag.Hotels as IEnumerable<TravelAI.Models.Hotel>
                  ?? Enumerable.Empty<TravelAI.Models.Hotel>();
}

<div class="room-form-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <div class="breadcrumb">
                <a asp-controller="Admin" asp-action="Index">
                    Dashboard
                </a>

                <span>/</span>

                <a asp-action="Index">
                    Phòng
                </a>

                <span>/</span>

                <span>Thêm phòng</span>
            </div>

            <h1>
                <i class="bi bi-plus-circle"></i>
                Thêm phòng mới
            </h1>

            <p>
                Nhập thông tin để thêm một phòng mới vào hệ thống.
            </p>
        </div>

        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>

    </div>


    <!-- FORM CARD -->
    <div class="form-card">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- THÔNG TIN CƠ BẢN -->
            <div class="section">

                <div class="section-title">
                    <div class="section-icon">
                        <i class="bi bi-door-open"></i>
                    </div>

                    <div>
                        <h2>Thông tin phòng</h2>
                        <p>Thông tin cơ bản của phòng</p>
                    </div>
                </div>


                <div class="form-grid">

                    <!-- TÊN PHÒNG -->
                    <div class="form-group">

                        <label asp-for="RoomName">
                            Tên phòng
                            <span>*</span>
                        </label>

                        <input asp-for="RoomName"
                               class="form-control"
                               placeholder="Ví dụ: Deluxe Room 101" />

                        <span asp-validation-for="RoomName"
                              class="field-error">
                        </span>

                    </div>


                    <!-- LOẠI PHÒNG -->
                    <div class="form-group">

                        <label asp-for="RoomType">
                            Loại phòng
                        </label>

                        <input asp-for="RoomType"
                               class="form-control"
                               placeholder="Ví dụ: Deluxe, Standard, Suite..." />

                        <span asp-validation-for="RoomType"
                              class="field-error">
                        </span>

                    </div>


                    <!-- KHÁCH SẠN -->
                    <div class="form-group full-width">

                        <label asp-for="HotelId">
                            Khách sạn
                            <span>*</span>
                        </label>

                        <select asp-for="HotelId"
                                class="form-control">

                            <option value="">
                                -- Chọn khách sạn --
                            </option>

                            @foreach (var hotel in hotels)
                            {
                                <option value="@hotel.Id">
                                    @hotel.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="HotelId"
                              class="field-error">
                        </span>

                    </div>


                    <!-- SỨC CHỨA -->
                    <div class="form-group">

                        <label asp-for="MaxGuests">
                            Số khách tối đa
                            <span>*</span>
                        </label>

                        <div class="input-with-icon">

                            <i class="bi bi-people"></i>

                            <input asp-for="MaxGuests"
                                   type="number"
                                   min="1"
                                   max="100"
                                   class="form-control"
                                   placeholder="Ví dụ: 2" />

                        </div>

                        <span asp-validation-for="MaxGuests"
                              class="field-error">
                        </span>

                    </div>


                    <!-- GIÁ -->
                    <div class="form-group">

                        <label asp-for="PricePerNight">
                            Giá mỗi đêm
                            <span>*</span>
                        </label>

                        <div class="input-with-icon">

                            <i class="bi bi-cash-stack"></i>

                            <input asp-for="PricePerNight"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   class="form-control"
                                   placeholder="Ví dụ: 1500000" />

                        </div>

                        <span class="input-hint">
                            Đơn vị: VNĐ / đêm
                        </span>

                        <span asp-validation-for="PricePerNight"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <!-- QUẢN LÝ SỐ LƯỢNG -->
            <div class="section">

                <div class="section-title">

                    <div class="section-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <div>
                        <h2>Số lượng phòng</h2>
                        <p>Thiết lập số lượng phòng</p>
                    </div>

                </div>


                <div class="form-grid">

                    <!-- TỔNG -->
                    <div class="form-group">

                        <label asp-for="Quantity">
                            Tổng số phòng
                            <span>*</span>
                        </label>

                        <div class="input-with-icon">

                            <i class="bi bi-building"></i>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="Ví dụ: 10" />

                        </div>

                        <span class="input-hint">
                            Tổng số phòng thuộc loại này
                        </span>

                        <span asp-validation-for="Quantity"
                              class="field-error">
                        </span>

                    </div>


                    <!-- CÒN TRỐNG -->
                    <div class="form-group">

                        <label asp-for="AvailableQuantity">
                            Số phòng còn trống
                            <span>*</span>
                        </label>

                        <div class="input-with-icon">

                            <i class="bi bi-check-circle"></i>

                            <input asp-for="AvailableQuantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="Ví dụ: 8" />

                        </div>

                        <span class="input-hint">
                            Không được lớn hơn tổng số phòng
                        </span>

                        <span asp-validation-for="AvailableQuantity"
                              class="field-error">
                        </span>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="form-group">

                        <label asp-for="Status">
                            Trạng thái
                        </label>

                        <select asp-for="Status"
                                class="form-control">

                            <option value="Available">
                                Đang hoạt động
                            </option>

                            <option value="Unavailable">
                                Tạm ngưng
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <!-- HÌNH ẢNH -->
            <div class="section">

                <div class="section-title">

                    <div class="section-icon">
                        <i class="bi bi-image"></i>
                    </div>

                    <div>
                        <h2>Hình ảnh</h2>
                        <p>Thêm hình ảnh đại diện cho phòng</p>
                    </div>

                </div>


                <div class="form-group">

                    <label asp-for="ImageUrl">
                        URL hình ảnh
                    </label>

                    <input asp-for="ImageUrl"
                           id="imageUrl"
                           class="form-control"
                           placeholder="https://..." />

                    <span class="input-hint">
                        Nhập đường dẫn hình ảnh của phòng.
                    </span>

                    <span asp-validation-for="ImageUrl"
                          class="field-error">
                    </span>

                </div>


                <!-- PREVIEW -->
                <div class="image-preview-container">

                    <div id="imagePlaceholder"
                         class="image-placeholder">

                        <i class="bi bi-image"></i>

                        <span>
                            Xem trước hình ảnh
                        </span>

                    </div>

                    <img id="imagePreview"
                         class="image-preview"
                         alt="Preview"
                         style="display:none;" />

                </div>

            </div>


            <!-- MÔ TẢ -->
            <div class="section">

                <div class="section-title">

                    <div class="section-icon">
                        <i class="bi bi-text-paragraph"></i>
                    </div>

                    <div>
                        <h2>Mô tả</h2>
                        <p>Mô tả chi tiết về phòng</p>
                    </div>

                </div>


                <div class="form-group">

                    <label asp-for="Description">
                        Mô tả phòng
                    </label>

                    <textarea asp-for="Description"
                              class="form-control textarea"
                              rows="6"
                              placeholder="Nhập mô tả về phòng, tiện nghi, đặc điểm nổi bật..."></textarea>

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- BUTTON -->
            <div class="form-footer">

                <a asp-action="Index"
                   class="btn-cancel">
                    Hủy
                </a>

                <button type="submit"
                        class="btn-submit">

                    <i class="bi bi-check-lg"></i>

                    Lưu phòng

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const imageUrl = document.getElementById("imageUrl");
        const imagePreview = document.getElementById("imagePreview");
        const imagePlaceholder =
            document.getElementById("imagePlaceholder");

        function previewImage() {

            const url = imageUrl.value.trim();

            if (!url) {

                imagePreview.style.display = "none";
                imagePlaceholder.style.display = "flex";

                return;
            }

            imagePreview.src = url;

            imagePreview.onload = function() {

                imagePreview.style.display = "block";
                imagePlaceholder.style.display = "none";

            };

            imagePreview.onerror = function() {

                imagePreview.style.display = "none";
                imagePlaceholder.style.display = "flex";

            };
        }

        imageUrl.addEventListener("input", previewImage);

        imageUrl.addEventListener("change", previewImage);

    </script>
}


<style>

    .room-form-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px;
    }


    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
    }

    .breadcrumb {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 10px;
        color: #9ca3af;
        font-size: 14px;
    }

        .breadcrumb a {
            color: #667eea;
            text-decoration: none;
        }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
    }

        .page-header h1 i {
            margin-right: 8px;
            color: #667eea;
        }

    .page-header p {
        margin: 7px 0 0;
        color: #7b8494;
        font-size: 15px;
    }


    /* BUTTON BACK */

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 16px;
        border: 1px solid #e1e5eb;
        background: white;
        color: #4b5563;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
        white-space: nowrap;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #374151;
        }


    /* FORM CARD */

    .form-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 22px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }


    /* SECTION */

    .section {
        padding: 25px;
        border-bottom: 1px solid #edf0f3;
    }

        .section:last-child {
            border-bottom: none;
        }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eef2ff;
        color: #667eea;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .section-title h2 {
        margin: 0;
        font-size: 18px;
        color: #1f2937;
    }

    .section-title p {
        margin: 3px 0 0;
        color: #9ca3af;
        font-size: 13px;
    }


    /* GRID */

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .full-width {
        grid-column: 1 / -1;
    }


    /* FORM */

    .form-group {
        margin-bottom: 2px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
        }

            .form-group label span {
                color: #ef4444;
            }

    .form-control {
        width: 100%;
        min-height: 44px;
        padding: 10px 13px;
        border: 1px solid #dfe4ea;
        border-radius: 8px;
        outline: none;
        background: white;
        color: #374151;
        font-size: 14px;
        box-sizing: border-box;
        transition: 0.2s;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .textarea {
        resize: vertical;
        min-height: 130px;
    }


    /* INPUT ICON */

    .input-with-icon {
        position: relative;
    }

        .input-with-icon > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            z-index: 1;
        }

        .input-with-icon .form-control {
            padding-left: 38px;
        }


    /* HINT */

    .input-hint {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #9ca3af;
    }


    /* ERROR */

    .field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .validation-summary {
        margin: 20px 25px 0;
        padding: 12px 15px;
        border-radius: 8px;
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

        .validation-summary:empty {
            display: none;
        }


    /* IMAGE */

    .image-preview-container {
        margin-top: 15px;
        width: 100%;
        min-height: 230px;
        border: 1px dashed #d5dbe3;
        border-radius: 10px;
        overflow: hidden;
        background: #f8fafc;
    }

    .image-placeholder {
        min-height: 230px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #9ca3af;
    }

        .image-placeholder i {
            font-size: 42px;
        }

    .image-preview {
        width: 100%;
        height: 300px;
        object-fit: cover;
    }


    /* FOOTER */

    .form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 20px 25px;
        background: #fafbfc;
    }

    .btn-cancel,
    .btn-submit {
        min-height: 43px;
        padding: 0 18px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-cancel {
        background: white;
        color: #4b5563;
        border: 1px solid #dfe4ea;
    }

        .btn-cancel:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .btn-submit {
        background: #667eea;
        color: white;
        border: none;
    }

        .btn-submit:hover {
            background: #5568d8;
        }


    /* RESPONSIVE */

    @@media (max-width: 700px) {

        .room-form-page {
            padding: 18px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .section {
            padding: 20px;
        }

        .form-footer {
            padding: 18px;
        }

        .btn-cancel,
        .btn-submit {
            flex: 1;
        }
    }

</style>