@model TravelAI.Models.Room

@{
    ViewData["Title"] = "Xóa phòng";
}

<style>
    .delete-page {
        max-width: 900px;
        margin: 30px auto;
    }

    .delete-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .delete-header h2 {
            margin: 0;
            font-weight: 700;
            color: #1f2937;
        }

        .delete-header p {
            margin: 6px 0 0;
            color: #6b7280;
        }

    .btn-back {
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        background: #f3f4f6;
        color: #374151;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #e5e7eb;
            color: #111827;
        }

    .warning-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        color: #9a3412;
    }

        .warning-box strong {
            display: block;
            font-size: 18px;
            margin-bottom: 6px;
        }

    .room-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        overflow: hidden;
    }

    .room-content {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 25px;
        padding: 25px;
    }

    .room-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 14px;
        background: #f3f4f6;
    }

    .room-info h3 {
        margin-top: 0;
        margin-bottom: 18px;
        color: #111827;
        font-size: 24px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 11px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-label {
        color: #6b7280;
        font-weight: 600;
    }

    .info-value {
        color: #111827;
        text-align: right;
        font-weight: 600;
    }

    .price {
        color: #dc2626;
        font-size: 18px;
    }

    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-available {
        background: #dcfce7;
        color: #166534;
    }

    .status-unavailable {
        background: #fee2e2;
        color: #991b1b;
    }

    .delete-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 25px;
        background: #fafafa;
        border-top: 1px solid #eeeeee;
    }

    .btn-delete {
        border: none;
        padding: 11px 22px;
        border-radius: 10px;
        background: #dc2626;
        color: white;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-cancel {
        text-decoration: none;
        padding: 11px 22px;
        border-radius: 10px;
        background: #e5e7eb;
        color: #374151;
        font-weight: 700;
    }

        .btn-cancel:hover {
            background: #d1d5db;
            color: #111827;
        }

    .description-box {
        margin-top: 20px;
        padding: 20px 25px;
        border-top: 1px solid #eeeeee;
    }

        .description-box h4 {
            margin-top: 0;
            color: #111827;
        }

        .description-box p {
            color: #6b7280;
            line-height: 1.7;
            margin-bottom: 0;
            white-space: pre-line;
        }

    @@media (max-width: 768px) {
        .delete-page {
            margin: 20px 15px;
        }

        .delete-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .room-content {
            grid-template-columns: 1fr;
        }

        .room-image {
            height: 240px;
        }

        .info-row {
            flex-direction: column;
            gap: 5px;
        }

        .info-value {
            text-align: left;
        }

        .delete-footer {
            flex-direction: column;
        }

        .btn-delete,
        .btn-cancel {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }
</style>

<div class="delete-page">

    <div class="delete-header">
        <div>
            <h2>Xóa phòng</h2>
            <p>Xác nhận thông tin trước khi xóa phòng khỏi hệ thống.</p>
        </div>

        <a asp-action="Index" class="btn-back">
            ← Quay lại danh sách
        </a>
    </div>

    <div class="warning-box">
        <strong>⚠️ Bạn có chắc chắn muốn xóa phòng này?</strong>
        Hành động này sẽ xóa phòng khỏi cơ sở dữ liệu và không thể hoàn tác.
    </div>

    <div class="room-card">

        <div class="room-content">

            <div>
                @{
                    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
                        ? "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=800&q=80"
                        : Model.ImageUrl;
                }

                <img src="@imageUrl"
                     alt="@Model.RoomName"
                     class="room-image" />
            </div>

            <div class="room-info">

                <h3>@Model.RoomName</h3>

                <div class="info-row">
                    <span class="info-label">Mã phòng</span>
                    <span class="info-value">#@Model.Id</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Khách sạn</span>
                    <span class="info-value">
                        @(Model.Hotel?.Name ?? "Chưa xác định")
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Loại phòng</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.RoomType)
                            ? "Chưa phân loại"
                            : Model.RoomType)
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Số khách tối đa</span>
                    <span class="info-value">
                        @Model.MaxGuests người
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Giá mỗi đêm</span>
                    <span class="info-value price">
                        @Model.PricePerNight.ToString("N0") ₫
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Tổng số phòng</span>
                    <span class="info-value">
                        @Model.Quantity
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Phòng còn trống</span>
                    <span class="info-value">
                        @Model.AvailableQuantity
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Trạng thái</span>

                    <span class="info-value">
                        @if (Model.Status == "Available")
                        {
                            <span class="status status-available">
                                Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="status status-unavailable">
                                Tạm ngưng
                            </span>
                        }
                    </span>
                </div>

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="description-box">
                <h4>Mô tả phòng</h4>
                <p>@Model.Description</p>
            </div>
        }

        <div class="delete-footer">

            <a asp-action="Index" class="btn-cancel">
                Hủy
            </a>

            <form asp-action="DeleteConfirmed"
                  method="post"
                  style="margin: 0;">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn-delete"
                        onclick="return confirm('Bạn có chắc chắn muốn xóa phòng này không?');">
                    🗑 Xác nhận xóa
                </button>

            </form>

        </div>

    </div>

</div>