@model TravelAI.Models.HotelBooking

@{
    ViewData["Title"] = "Đặt phòng thành công";

    var hotelImage = string.IsNullOrWhiteSpace(Model.Hotel?.ImageUrl)
        ? "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80"
        : Model.Hotel.ImageUrl;

    var totalNights = (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days;
}

<div class="container py-5">

    <!-- ================= SUCCESS ================= -->

    <div class="text-center mb-5">

        <div class="mb-3">

            <div class="d-inline-flex align-items-center justify-content-center
                rounded-circle bg-success bg-opacity-10"
                 style="width:80px; height:80px;">

                <i class="bi bi-check-circle-fill text-success"
                   style="font-size:42px;"></i>

            </div>

        </div>

        @if (Model.Status == "Cancelled")
        {
            <h2 class="fw-bold text-danger">
                <i class="bi bi-x-circle me-2"></i>
                Đặt phòng đã được hủy
            </h2>
        }
        else
        {
            <h2 class="fw-bold text-success">
                <i class="bi bi-check-circle me-2"></i>
                Đặt phòng thành công
            </h2>
        }

        <p class="text-muted mb-0">
            Cảm ơn bạn đã lựa chọn TravelAI.
            Thông tin đặt phòng của bạn đã được ghi nhận.
        </p>

    </div>


    <!-- ================= BOOKING CODE ================= -->

    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4">

        <div class="row align-items-center">

            <div class="col-md-8">

                <div class="small text-success fw-semibold mb-1">
                    MÃ ĐẶT PHÒNG
                </div>

                <div class="fs-4 fw-bold">
                    @Model.BookingCode
                </div>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <span class="badge bg-warning text-dark px-3 py-2">
                    @Model.Status
                </span>

            </div>

        </div>

    </div>


    <!-- ================= HOTEL INFORMATION ================= -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

        <div class="row g-0">

            <!-- IMAGE -->

            <div class="col-lg-4">

                <img src="@hotelImage"
                     alt="@Model.Hotel?.Name"
                     class="w-100 h-100"
                     style="min-height:260px; object-fit:cover;" />

            </div>


            <!-- HOTEL -->

            <div class="col-lg-8">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-muted small mb-2">
                        KHÁCH SẠN
                    </div>

                    <h2 class="fw-bold mb-3">
                        @Model.Hotel?.Name
                    </h2>

                    @if (Model.Hotel != null)
                    {
                        <div class="text-muted mb-3">

                            <i class="bi bi-geo-alt me-2"></i>

                            @Model.Hotel.Address

                            @if (!string.IsNullOrWhiteSpace(Model.Hotel.City))
                            {
                                <span>
                                    , @Model.Hotel.City
                                </span>
                            }

                        </div>
                    }


                    <div class="d-flex align-items-center gap-2">

                        <span class="text-warning">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (Model.Hotel != null &&
                                    i <= Math.Round(Model.Hotel.Rating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }

                        </span>

                        @if (Model.Hotel != null)
                        {
                            <span class="fw-semibold">
                                @Model.Hotel.Rating.ToString("0.0")
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= ROOM + BOOKING INFO ================= -->

    <div class="row g-4">

        <!-- ROOM -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4 p-lg-5">

                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-door-open me-2 text-primary"></i>
                        Thông tin phòng
                    </h4>


                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            LOẠI PHÒNG
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Model.Room?.RoomName
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Room?.RoomType))
                    {
                        <div class="mb-4">

                            <div class="text-muted small mb-1">
                                HẠNG PHÒNG
                            </div>

                            <div>
                                @Model.Room.RoomType
                            </div>

                        </div>
                    }


                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="bg-light rounded-3 p-3">

                                <div class="text-muted small mb-1">
                                    Số khách
                                </div>

                                <div class="fw-bold">
                                    @Model.NumberOfGuests khách
                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="bg-light rounded-3 p-3">

                                <div class="text-muted small mb-1">
                                    Số phòng
                                </div>

                                <div class="fw-bold">
                                    @Model.NumberOfRooms phòng
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- DATE + PRICE -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4 p-lg-5">

                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-calendar-check me-2 text-primary"></i>
                        Chi tiết đặt phòng
                    </h4>


                    <!-- CHECK IN -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Nhận phòng
                        </span>

                        <strong>
                            @Model.CheckInDate.ToString("dd/MM/yyyy")
                        </strong>

                    </div>


                    <!-- CHECK OUT -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Trả phòng
                        </span>

                        <strong>
                            @Model.CheckOutDate.ToString("dd/MM/yyyy")
                        </strong>

                    </div>


                    <!-- NIGHTS -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Số đêm
                        </span>

                        <strong>
                            @totalNights đêm
                        </strong>

                    </div>


                    <hr />


                    <!-- PAYMENT STATUS -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Thanh toán
                        </span>

                        <span class="badge bg-secondary">
                            @Model.PaymentStatus
                        </span>

                    </div>


                    <!-- TOTAL -->

                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 mt-4">

                        <div class="text-muted small mb-1">
                            TỔNG TIỀN
                        </div>

                        <div class="fs-3 fw-bold text-primary">

                            @Model.TotalPrice.ToString("N0") đ

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= NOTE ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="card border-0 shadow-sm rounded-4 mt-4">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-2">

                    <i class="bi bi-chat-left-text me-2 text-primary"></i>

                    Ghi chú

                </h5>

                <p class="text-muted mb-0">
                    @Model.Note
                </p>

            </div>

        </div>
    }


    <!-- ================= ACTIONS ================= -->

    <div class="d-flex flex-column flex-md-row gap-3 justify-content-center mt-5">

        <a asp-controller="Hotel"
           asp-action="Index"
           class="btn btn-primary btn-lg rounded-3 px-4">

            <i class="bi bi-building me-2"></i>

            Xem thêm khách sạn

        </a>


        <a asp-controller="Booking"
           asp-action="Index"
           class="btn btn-outline-secondary btn-lg rounded-3 px-4">

            <i class="bi bi-receipt me-2"></i>

            Đơn của tôi

        </a>
        @if (Model.PaymentStatus != "Paid" &&
             Model.Status != "Cancelled")
        {
            <a asp-controller="Payment"
               asp-action="CreateHotel"
               asp-route-hotelBookingId="@Model.Id"
               class="btn btn-success btn-lg rounded-3 px-4">

                <i class="bi bi-credit-card me-2"></i>

                Thanh toán

            </a>
        }

        @if (Model.Status != "Cancelled")
        {
            <form asp-controller="Hotel"
                  asp-action="CancelBooking"
                  method="post"
                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đặt phòng này không?');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-outline-danger btn-lg rounded-3 px-4">

                    <i class="bi bi-x-circle me-2"></i>

                    Hủy đặt phòng

                </button>

            </form>
        }

    </div>


    <!-- ================= NOTICE ================= -->

    <div class="text-center text-muted small mt-4">

        <i class="bi bi-info-circle me-1"></i>

        Vui lòng lưu lại mã đặt phòng
        <strong>@Model.BookingCode</strong>
        để thuận tiện tra cứu.

    </div>

</div>