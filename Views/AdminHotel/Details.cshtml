@model TravelAI.Models.Hotel

@{
    ViewData["Title"] = "Chi tiết khách sạn";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-controller="AdminHotel"
               asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="bi bi-arrow-left"></i>
                Quay lại danh sách

            </a>

            <h2 class="fw-bold mt-3 mb-1">

                <i class="bi bi-building text-primary"></i>

                Chi tiết khách sạn

            </h2>

            <p class="text-muted mb-0">
                Xem toàn bộ thông tin của khách sạn.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="AdminHotel"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil"></i>
                Chỉnh sửa

            </a>

            <a asp-controller="AdminHotel"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">

                <i class="bi bi-trash"></i>
                Xóa

            </a>

        </div>

    </div>


    <!-- ================= HOTEL OVERVIEW ================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row g-4 align-items-center">

                <!-- IMAGE -->

                <div class="col-lg-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="hotel-main-image" />
                    }
                    else
                    {
                        <div class="hotel-no-image">

                            <i class="bi bi-building"></i>

                            <span>
                                Chưa có hình ảnh
                            </span>

                        </div>
                    }

                </div>


                <!-- BASIC INFO -->

                <div class="col-lg-8">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h3 class="fw-bold mb-2">
                                @Model.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(Model.Slug))
                            {
                                <div class="text-muted mb-3">

                                    <i class="bi bi-link-45deg"></i>

                                    /@Model.Slug

                                </div>
                            }

                        </div>


                        <!-- STATUS -->
                        @if (Model.Status == "Active")
                        {
                            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">

                                <i class="bi bi-check-circle"></i>

                                Đang hoạt động

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2">

                                <i class="bi bi-pause-circle"></i>

                                Tạm ngưng

                            </span>
                        }

                    </div>


                    <!-- ADDRESS -->

                    <div class="info-row">

                        <div class="info-icon">

                            <i class="bi bi-geo-alt text-danger"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                Địa chỉ
                            </div>

                            <div class="text-muted">
                                @Model.Address
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.City) ||
                                 !string.IsNullOrWhiteSpace(Model.Province))
                            {
                                <div class="text-muted">

                                    @Model.City

                                    @if (!string.IsNullOrWhiteSpace(Model.City) &&
                                         !string.IsNullOrWhiteSpace(Model.Province))
                                    {
                                        <span>, </span>
                                    }

                                    @Model.Province

                                </div>
                            }

                        </div>

                    </div>


                    <!-- DESTINATION -->
                    @if (Model.Destination != null)
                    {
                        <div class="info-row">

                            <div class="info-icon">

                                <i class="bi bi-pin-map text-primary"></i>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Điểm đến
                                </div>

                                <div class="text-muted">
                                    @Model.Destination.Name
                                </div>

                            </div>

                        </div>
                    }


                    <!-- RATING -->

                    <div class="info-row">

                        <div class="info-icon">

                            <i class="bi bi-star-fill text-warning"></i>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                Đánh giá
                            </div>

                            <div>

                                <span class="fw-bold">
                                    @Model.Rating.ToString("0.0")
                                </span>

                                <span class="text-warning ms-1">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(Model.Rating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                </span>

                                <span class="text-muted ms-2">
                                    (@Model.ReviewCount đánh giá)
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= STATISTICS ================= -->

    <div class="row g-4 mb-4">

        <!-- ROOMS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted mb-1">
                                Tổng số phòng
                            </div>

                            <h3 class="fw-bold mb-0">
                                @(Model.Rooms?.Count ?? 0)
                            </h3>

                        </div>

                        <div class="stat-icon bg-primary-subtle text-primary">

                            <i class="bi bi-door-open"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- BOOKINGS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted mb-1">
                                Tổng số booking
                            </div>

                            <h3 class="fw-bold mb-0">
                                @(Model.HotelBookings?.Count ?? 0)
                            </h3>

                        </div>

                        <div class="stat-icon bg-success-subtle text-success">

                            <i class="bi bi-calendar-check"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- REVIEWS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted mb-1">
                                Tổng đánh giá
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.ReviewCount
                            </h3>

                        </div>

                        <div class="stat-icon bg-warning-subtle text-warning">

                            <i class="bi bi-star"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= DESCRIPTION ================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-file-text text-primary me-1"></i>

                Mô tả khách sạn

            </h5>

        </div>


        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="description-text">

                    @Model.Description

                </div>
            }
            else
            {
                <div class="text-muted">

                    <i class="bi bi-info-circle"></i>

                    Chưa có mô tả cho khách sạn này.

                </div>
            }

        </div>

    </div>


    <!-- ================= ROOMS ================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-door-open text-primary me-1"></i>

                    Danh sách phòng

                </h5>

                <span class="badge bg-primary-subtle text-primary">

                    @(Model.Rooms?.Count ?? 0) phòng

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Rooms == null || !Model.Rooms.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-door-closed text-muted"
                       style="font-size: 50px;">
                    </i>

                    <h6 class="fw-semibold mt-3">
                        Chưa có phòng
                    </h6>

                    <p class="text-muted mb-0">
                        Khách sạn này chưa được thêm phòng nào.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:70px;">
                                    STT
                                </th>

                                <th>
                                    Tên phòng
                                </th>

                                <th>
                                    Loại phòng
                                </th>

                                <th class="text-center">
                                    Sức chứa
                                </th>

                                <th class="text-center">
                                    Giá / đêm
                                </th>

                                <th class="text-center">
                                    Số lượng
                                </th>

                                <th class="text-center">
                                    Trạng thái
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int roomStt = 1;
                            }

                            @foreach (var room in Model.Rooms)
                            {
                                <tr>

                                    <!-- STT -->

                                    <td class="fw-semibold">
                                        @roomStt
                                    </td>


                                    <!-- TÊN PHÒNG -->

                                    <td>

                                        <div class="fw-semibold">
                                            @room.RoomName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(room.Description))
                                        {
                                            <small class="text-muted">

                                                @room.Description

                                            </small>
                                        }

                                    </td>


                                    <!-- LOẠI PHÒNG -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(room.RoomType))
                                        {
                                            @room.RoomType
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa xác định
                                            </span>
                                        }

                                    </td>


                                    <!-- SỨC CHỨA -->

                                    <td class="text-center">

                                        <i class="bi bi-people"></i>

                                        @room.MaxGuests người

                                    </td>


                                    <!-- GIÁ -->

                                    <td class="text-center">

                                        <span class="fw-semibold">

                                            @room.PricePerNight.ToString("N0")

                                        </span>

                                        <small class="text-muted">
                                            VNĐ/đêm
                                        </small>

                                    </td>


                                    <!-- SỐ LƯỢNG -->

                                    <td class="text-center">

                                        <div class="fw-semibold">
                                            @room.Quantity
                                        </div>

                                        <small class="text-muted">

                                            Còn @room.AvailableQuantity

                                        </small>

                                    </td>


                                    <!-- TRẠNG THÁI -->

                                    <td class="text-center">

                                        @if (room.Status == "Available")
                                        {
                                            <span class="badge bg-success-subtle text-success">

                                                <i class="bi bi-check-circle"></i>

                                                Có sẵn

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">

                                                @room.Status

                                            </span>
                                        }

                                    </td>

                                </tr>

                                roomStt++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- ================= SYSTEM INFORMATION ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-database text-primary me-1"></i>

                Thông tin hệ thống

            </h5>

        </div>


        <div class="card-body">

            <div class="row">

                <!-- ID -->

                <div class="col-md-4 mb-3 mb-md-0">

                    <div class="text-muted small">
                        ID khách sạn
                    </div>

                    <div class="fw-semibold">
                        #@Model.Id
                    </div>

                </div>


                <!-- CREATED -->

                <div class="col-md-4 mb-3 mb-md-0">

                    <div class="text-muted small">
                        Ngày tạo
                    </div>

                    <div class="fw-semibold">

                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-4">

                    <div class="text-muted small">
                        Trạng thái
                    </div>

                    <div class="fw-semibold">

                        @if (Model.Status == "Active")
                        {
                            <span class="text-success">
                                Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                Tạm ngưng
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ================= STYLE ================= -->

<style>

    .card {
        border-radius: 14px;
    }

    .card-header {
        border-radius: 14px 14px 0 0 !important;
    }

    .hotel-main-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
        border-radius: 12px;
    }

    .hotel-no-image {
        width: 100%;
        height: 280px;
        border-radius: 12px;
        background: #f1f3f5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
    }

        .hotel-no-image i {
            font-size: 70px;
            margin-bottom: 10px;
        }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 18px;
    }

    .info-icon {
        width: 32px;
        min-width: 32px;
        font-size: 18px;
        text-align: center;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .description-text {
        white-space: pre-line;
        line-height: 1.8;
        color: #495057;
    }

    .table > :not(caption) > * > * {
        padding: 14px 12px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn {
        border-radius: 8px;
    }

    .badge {
        font-weight: 500;
    }

</style>