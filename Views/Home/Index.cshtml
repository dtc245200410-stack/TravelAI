    </div>

</section>


<!-- =========================================================
     CALL TO ACTION
     ========================================================= -->

<section class="home-cta">

    <div class="container">

        <div class="cta-content">

            <h2>
                Sẵn sàng cho chuyến đi tiếp theo?
            </h2>

            <p>

                Khám phá hàng trăm hành trình và tìm lựa chọn
                phù hợp nhất với bạn.

            </p>


            <a href="#" class="cta-button">

                Khám phá ngay

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>