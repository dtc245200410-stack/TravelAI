@{
    ViewData["Title"] = "Trang chủ";
}

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="travel-hero">

    <div class="travel-hero-overlay"></div>

    <div class="container position-relative">

        <div class="hero-content">

            <span class="hero-badge">
                <i class="bi bi-stars"></i>
                Du lịch thông minh cùng AI
            </span>

            <h1>
                Khám phá hành trình<br />
                <span>của riêng bạn</span>
            </h1>

            <p>
                Tìm tour, khách sạn và những trải nghiệm phù hợp
                với sở thích, thời gian và ngân sách của bạn.
            </p>

        </div>


        <!-- SEARCH BOX -->

        <div class="travel-search-box">

            <div class="search-tabs">

                <button class="search-tab active">
                    <i class="bi bi-map"></i>
                    Tour
                </button>

                <button class="search-tab">
                    <i class="bi bi-building"></i>
                    Khách sạn
                </button>

                <!-- COMBO -->
                <a href="/Combo/Index"
                   style="display: inline-block; position: relative; z-index: 9999; cursor: pointer; color: inherit; text-decoration: none;">

                    <i class="bi bi-box-seam"></i>
                    Combo

                </a>

            </div>


            <div class="search-form">

                <div class="search-field">

                    <i class="bi bi-geo-alt"></i>

                    <div>
                        <label>Điểm đến</label>

                        <input type="text"
                               placeholder="Bạn muốn đi đâu?" />

                    </div>

                </div>


                <div class="search-field">

                    <i class="bi bi-calendar3"></i>

                    <div>
                        <label>Ngày đi</label>

                        <input type="date" />
                    </div>

                </div>


                <div class="search-field">

                    <i class="bi bi-people"></i>

                    <div>
                        <label>Số người</label>

                        <select>

                            <option>1 người</option>
                            <option>2 người</option>
                            <option>3 người</option>
                            <option>4 người</option>
                            <option>5+ người</option>

                        </select>

                    </div>

                </div>


                <button class="search-button">

                    <i class="bi bi-search"></i>
                    Tìm kiếm

                </button>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     QUICK FEATURES
     ========================================================= -->

<section class="quick-features">

    <div class="container">

        <div class="row g-3">

            <div class="col-lg-3 col-md-6">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>
                        <h6>Gợi ý bằng AI</h6>
                        <p>Tìm chuyến đi phù hợp với bạn</p>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <h6>Đặt dịch vụ an tâm</h6>
                        <p>Thông tin rõ ràng, minh bạch</p>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-tags"></i>
                    </div>

                    <div>
                        <h6>Ưu đãi hấp dẫn</h6>
                        <p>Nhiều lựa chọn theo ngân sách</p>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <div>
                        <h6>Hỗ trợ nhanh chóng</h6>
                        <p>Đồng hành trong suốt chuyến đi</p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     DESTINATIONS
     ========================================================= -->

<section class="home-section">

    <div class="container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    KHÁM PHÁ
                </span>

                <h2>Điểm đến nổi bật</h2>

                <p>
                    Những địa điểm được nhiều du khách lựa chọn
                </p>

            </div>

            <a href="#" class="view-all">

                Xem tất cả

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-4">

            <!-- DA NANG -->

            <div class="col-lg-4 col-md-6">

                <div class="destination-card">

                    <img src="https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=900&q=80"
                         alt="Đà Nẵng" />

                    <div class="destination-overlay">

                        <span>Miền Trung</span>

                        <h3>Đà Nẵng</h3>

                        <p>
                            Biển xanh · Ẩm thực · Trải nghiệm
                        </p>

                    </div>

                </div>

            </div>


            <!-- DA LAT -->

            <div class="col-lg-4 col-md-6">

                <div class="destination-card">

                    <img src="https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=900&q=80"
                         alt="Đà Lạt" />

                    <div class="destination-overlay">

                        <span>Tây Nguyên</span>

                        <h3>Đà Lạt</h3>

                        <p>
                            Khí hậu mát mẻ · Thiên nhiên
                        </p>

                    </div>

                </div>

            </div>


            <!-- PHU QUOC -->

            <div class="col-lg-4 col-md-6">

                <div class="destination-card">

                    <img src="https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=900&q=80"
                         alt="Phú Quốc" />

                    <div class="destination-overlay">

                        <span>Miền Nam</span>

                        <h3>Phú Quốc</h3>

                        <p>
                            Biển đảo · Nghỉ dưỡng · Hoàng hôn
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURED TOURS
     ========================================================= -->

<section class="home-section section-light">

    <div class="container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    GỢI Ý CHO BẠN
