                        </div>

                        <h3>
                            Khám phá Phú Quốc - Thiên đường biển đảo
                        </h3>


                        <div class="tour-info">

                            <span>

                                <i class="bi bi-clock"></i>
                                4 ngày 3 đêm

                            </span>

                            <span>

                                <i class="bi bi-star-fill"></i>
                                4.8

                            </span>

                        </div>


                        <div class="tour-footer">

                            <div>

                                <small>Giá từ</small>

                                <strong>
                                    4.590.000đ
                                </strong>

                            </div>

                            <a href="#" class="tour-detail-button">
                                Xem tour
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- TOUR 3 -->

            <div class="col-lg-4 col-md-6">

                <div class="tour-card">

                    <div class="tour-image">

                        <img src="https://images.unsplash.com/photo-1504214208698-ea1916f2195a?auto=format&fit=crop&w=800&q=80"
                             alt="Tour Tây Bắc" />

                        <span class="tour-badge">
                            Mới
                        </span>

                        <button class="favorite-button">

                            <i class="bi bi-heart"></i>

                        </button>

                    </div>


                    <div class="tour-body">

                        <div class="tour-location">

                            <i class="bi bi-geo-alt"></i>
                            Tây Bắc

                        </div>

                        <h3>
                            Hà Nội - Sapa - Fansipan
                        </h3>


                        <div class="tour-info">

                            <span>

                                <i class="bi bi-clock"></i>
