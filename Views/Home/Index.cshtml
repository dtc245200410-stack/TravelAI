                        <div class="tour-footer">

                            <div>

                                <small>Giá từ</small>

                                <strong>
                                    3.490.000đ
                                </strong>

                            </div>

                            <a href="#" class="tour-detail-button">
                                Xem tour
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     AI SECTION
     ========================================================= -->

<section class="ai-home-section">

    <div class="container">

        <div class="ai-home-card">

            <div class="ai-content">

                <span class="ai-label">

                    <i class="bi bi-stars"></i>
                    TRAVEL AI

                </span>


                <h2>

                    Không biết đi đâu?<br />
                    Hãy để AI lên kế hoạch cho bạn.

                </h2>


                <p>

                    Cho TravelAI biết ngân sách, thời gian,
                    số người và sở thích. AI sẽ giúp bạn
                    tìm điểm đến, tour và khách sạn phù hợp.

                </p>


                <div class="ai-example">

                    <i class="bi bi-chat-left-text"></i>

                    <span>

                        "Tôi có 6 triệu, muốn đi Đà Nẵng
                        3 ngày 2 đêm cho 2 người..."

                    </span>

                </div>


                <a href="#" class="ai-button">

                    <i class="bi bi-stars"></i>
                    Tư vấn với Travel AI

                </a>

            </div>


            <div class="ai-visual">

                <div class="ai-circle">

                    <i class="bi bi-stars"></i>

                </div>


                <div class="ai-floating-card ai-card-one">

                    <i class="bi bi-geo-alt"></i>

                    <span>
                        Điểm đến phù hợp
                    </span>

                </div>


                <div class="ai-floating-card ai-card-two">

                    <i class="bi bi-wallet2"></i>

                    <span>
                        Theo ngân sách
                    </span>

                </div>


                <div class="ai-floating-card ai-card-three">

                    <i class="bi bi-calendar-check"></i>

                    <span>
                        Lịch trình thông minh
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>


