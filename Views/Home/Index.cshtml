                        <span class="tour-badge">
                            Ưu đãi
                        </span>

                        <button class="favorite-button">

                            <i class="bi bi-heart"></i>

                        </button>

                    </div>


                    <div class="tour-body">

                        <div class="tour-location">

                            <i class="bi bi-geo-alt"></i>
