@model TravelAI.Models.Booking

@{
    ViewData["Title"] = "Xác nhận đặt tour";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <div class="display-3 mb-3">✅</div>

        <h1 class="fw-bold text-success">
            Đặt tour thành công!
        </h1>

        <p class="text-muted mt-2">
            Cảm ơn bạn đã lựa chọn TravelAI.
            Thông tin đặt tour của bạn đã được ghi nhận.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small opacity-75">
                                MÃ ĐẶT TOUR
                            </div>

                            <h4 class="fw-bold mb-0">
                                @Model.BookingCode
                            </h4>
                        </div>

                        <span class="badge bg-warning text-dark px-3 py-2">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">

                    @if (Model.Tour != null)
                    {
                        <div class="mb-4">

                            <h4 class="fw-bold mb-3">
                                Thông tin tour
                            </h4>

                            <div class="row g-4">

                                <div class="col-md-5">
                                    <img src="@Model.Tour.ImageUrl"
                                         alt="@Model.Tour.Name"
                                         class="img-fluid rounded-4"
                                         style="width:100%; height:220px; object-fit:cover;" />
                                </div>

                                <div class="col-md-7">

                                    <h5 class="fw-bold">
                                        @Model.Tour.Name
                                    </h5>

                                    <div class="text-muted mt-3">

                                        <div class="mb-2">
                                            📍
                                            <strong>Điểm đến:</strong>
                                            @Model.Tour.Destination?.Name
                                        </div>

                                        <div class="mb-2">
                                            📍
                                            <strong>Khởi hành:</strong>
                                            @Model.Tour.DepartureLocation
                                        </div>

                                        <div class="mb-2">
                                            📅
                                            <strong>Ngày đi:</strong>
                                            @Model.Tour.DepartureDate.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            🕒
                                            <strong>Thời gian:</strong>
                                            @Model.Tour.Duration ngày
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                    <hr />

                    <h4 class="fw-bold mb-4">
                        Chi tiết đặt tour
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted">
                                    Số người
                                </div>

                                <div class="fw-bold fs-5">
                                    @Model.NumberOfPeople người
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted">
                                    Ngày đặt
                                </div>

                                <div class="fw-bold">
                                    @Model.BookingDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted">
                                    Thanh toán
                                </div>

                                <div class="fw-bold">
                                    @Model.PaymentStatus
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted">
                                    Phương thức thanh toán
                                </div>

                                <div class="fw-bold">
                                    @(Model.PaymentMethod ?? "Chưa chọn")
                                </div>
                            </div>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="mt-4">
                            <div class="small text-muted mb-1">
                                Ghi chú
                            </div>

                            <div class="p-3 bg-light rounded-3">
                                @Model.Note
                            </div>
                        </div>
                    }

                    <div class="border-top mt-4 pt-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="fw-semibold fs-5">
                                Tổng tiền
                            </span>

                            <span class="text-danger fw-bold fs-2">
                                @Model.TotalPrice.ToString("N0") đ
                            </span>

                        </div>

                    </div>

                    <div class="d-flex gap-3 mt-4">

                        <a asp-controller="Tour"
                           asp-action="Index"
                           class="btn btn-outline-secondary flex-fill">
                            ← Xem thêm tour
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary flex-fill">
                            Về trang chủ
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>