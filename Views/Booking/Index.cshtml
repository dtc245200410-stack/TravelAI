@model TravelAI.Models.ViewModels.MyBookingViewModel

@{
    ViewData["Title"] = "Đơn của tôi";
}

<div class="container py-5">

    <!-- ================= HEADER ================= -->

    <div class="mb-5">

        <h1 class="fw-bold mb-2">
            Đơn của tôi
        </h1>

        <p class="text-muted mb-0">
            Theo dõi các tour và phòng khách sạn bạn đã đặt tại TravelAI.
        </p>

    </div>


    <!-- ================= TOUR BOOKINGS ================= -->

    <div class="mb-5">

        <div class="d-flex align-items-center justify-content-between mb-4">

            <div>

                <h3 class="fw-bold mb-1">

                    <i class="bi bi-map me-2 text-primary"></i>

                    Đơn đặt tour

                </h3>

                <p class="text-muted mb-0">
                    Các tour bạn đã đăng ký.
                </p>

            </div>

            <span class="badge bg-primary rounded-pill px-3 py-2">
                @Model.TourBookings.Count đơn
            </span>

        </div>


        @if (Model.TourBookings.Any())
        {
            <div class="row g-4">

                @foreach (var booking in Model.TourBookings)
                {
                    <div class="col-12">

                        <div class="card border-0 shadow-sm rounded-4">

                            <div class="card-body p-4">

                                <div class="row align-items-center g-4">

                                    <!-- TOUR INFORMATION -->

                                    <div class="col-lg-5">

                                        <div class="small text-muted mb-1">
                                            MÃ ĐẶT TOUR
                                        </div>

                                        <div class="fw-bold text-primary mb-2">
                                            @booking.BookingCode
                                        </div>

                                        <h5 class="fw-bold mb-2">
                                            @booking.Tour?.Name
                                        </h5>

                                        @if (booking.Tour?.Destination != null)
                                        {
                                            <div class="text-muted small">

                                                <i class="bi bi-geo-alt me-1"></i>

                                                @booking.Tour.Destination.Name

                                            </div>
                                        }

                                    </div>


                                    <!-- BOOKING INFO -->

                                    <div class="col-lg-4">

                                        <div class="row g-3">

                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Số người
                                                    </div>

                                                    <div class="fw-bold">
                                                        @booking.NumberOfPeople
                                                    </div>

                                                </div>

                                            </div>


                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Ngày đặt
                                                    </div>

                                                    <div class="fw-bold small">
                                                        @booking.BookingDate.ToString("dd/MM/yyyy")
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- PRICE + STATUS -->

                                    <div class="col-lg-3 text-lg-end">

                                        <div class="small text-muted mb-1">
                                            Tổng tiền
                                        </div>

                                        <div class="fs-5 fw-bold text-primary mb-2">
                                            @booking.TotalPrice.ToString("N0") đ
                                        </div>

                                        <span class="badge bg-warning text-dark">
                                            @booking.Status
                                        </span>

                                        <div class="mt-3">

                                            <a asp-controller="Booking"
                                               asp-action="Details"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-outline-primary btn-sm rounded-3">

                                                Xem chi tiết

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center py-5">

                    <i class="bi bi-map text-muted"
                       style="font-size:48px;"></i>

                    <h5 class="fw-bold mt-3">
                        Chưa có đơn đặt tour
                    </h5>

                    <p class="text-muted">
                        Bạn chưa đặt tour nào.
                    </p>

                    <a asp-controller="Tour"
                       asp-action="Index"
                       class="btn btn-primary rounded-3">

                        <i class="bi bi-search me-1"></i>

                        Tìm tour

                    </a>

                </div>

            </div>
        }

    </div>


    <!-- ================= HOTEL BOOKINGS ================= -->

    <div class="mb-5">

        <div class="d-flex align-items-center justify-content-between mb-4">

            <div>

                <h3 class="fw-bold mb-1">

                    <i class="bi bi-building me-2 text-primary"></i>

                    Đơn đặt phòng

                </h3>

                <p class="text-muted mb-0">
                    Các phòng khách sạn bạn đã đặt.
                </p>

            </div>

            <span class="badge bg-primary rounded-pill px-3 py-2">
                @Model.HotelBookings.Count đơn
            </span>

        </div>


        @if (Model.HotelBookings.Any())
        {
            <div class="row g-4">

                @foreach (var booking in Model.HotelBookings)
                {
                    <div class="col-12">

                        <div class="card border-0 shadow-sm rounded-4">

                            <div class="card-body p-4">

                                <div class="row align-items-center g-4">

                                    <!-- HOTEL INFORMATION -->

                                    <div class="col-lg-5">

                                        <div class="small text-muted mb-1">
                                            MÃ ĐẶT PHÒNG
                                        </div>

                                        <div class="fw-bold text-primary mb-2">
                                            @booking.BookingCode
                                        </div>

                                        <h5 class="fw-bold mb-2">
                                            @booking.Hotel?.Name
                                        </h5>

                                        @if (booking.Room != null)
                                        {
                                            <div class="text-muted small">

                                                <i class="bi bi-door-open me-1"></i>

                                                @booking.Room.RoomName

                                            </div>
                                        }

                                    </div>


                                    <!-- BOOKING INFO -->

                                    <div class="col-lg-4">

                                        <div class="row g-3">

                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Nhận phòng
                                                    </div>

                                                    <div class="fw-bold small">
                                                        @booking.CheckInDate.ToString("dd/MM/yyyy")
                                                    </div>

                                                </div>

                                            </div>


                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Trả phòng
                                                    </div>

                                                    <div class="fw-bold small">
                                                        @booking.CheckOutDate.ToString("dd/MM/yyyy")
                                                    </div>

                                                </div>

                                            </div>


                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Số khách
                                                    </div>

                                                    <div class="fw-bold">
                                                        @booking.NumberOfGuests
                                                    </div>

                                                </div>

                                            </div>


                                            <div class="col-6">

                                                <div class="bg-light rounded-3 p-3">

                                                    <div class="text-muted small">
                                                        Số phòng
                                                    </div>

                                                    <div class="fw-bold">
                                                        @booking.NumberOfRooms
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- PRICE + STATUS -->

                                    <div class="col-lg-3 text-lg-end">

                                        <div class="small text-muted mb-1">
                                            Tổng tiền
                                        </div>

                                        <div class="fs-5 fw-bold text-primary mb-2">
                                            @booking.TotalPrice.ToString("N0") đ
                                        </div>

                                        <span class="badge bg-warning text-dark">
                                            @booking.Status
                                        </span>

                                        <div class="mt-3">

                                            <a asp-controller="Hotel"
                                               asp-action="BookingDetails"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-outline-primary btn-sm rounded-3">

                                                Xem chi tiết

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center py-5">

                    <i class="bi bi-building text-muted"
                       style="font-size:48px;"></i>

                    <h5 class="fw-bold mt-3">
                        Chưa có đơn đặt phòng
                    </h5>

                    <p class="text-muted">
                        Bạn chưa đặt phòng khách sạn nào.
                    </p>

                    <a asp-controller="Hotel"
                       asp-action="Index"
                       class="btn btn-primary rounded-3">

                        <i class="bi bi-search me-1"></i>

                        Tìm khách sạn

                    </a>

                </div>

            </div>
        }

    </div>

</div>