<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TravelAI</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="travel-header">

        <div class="container">

            <nav class="navbar navbar-expand-lg">

                <!-- LOGO -->

                <a class="navbar-brand travel-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="logo-icon">
                        <i class="bi bi-airplane"></i>
                    </span>

                    <span>
                        Travel<span class="logo-ai">AI</span>
                    </span>

                </a>


                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav mx-auto">

                        <!-- TRANG CHỦ -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Trang chủ

                            </a>

                        </li>


                        <!-- TOUR -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Tour"
                               asp-action="Index">

                                Tour

                            </a>

                        </li>


                        <!-- KHÁCH SẠN -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Hotel"
                               asp-action="Index">

                                Khách sạn

                            </a>

                        </li>


                        <!-- COMBO -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Combo"
                               asp-action="Index">

                                Combo

                            </a>

                        </li>


                        <!-- ĐƠN CỦA TÔI -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Booking"
                               asp-action="Index">

                                <i class="bi bi-receipt"></i>
                                Đơn của tôi

                            </a>

                        </li>


                        <!-- TRAVEL AI -->

                        <li class="nav-item">

                            <a class="nav-link ai-nav-link"
                               asp-controller="AI"
                               asp-action="Index">

                                <i class="bi bi-stars"></i>
                                Travel AI

                            </a>

                        </li>
                        @if (User.Identity?.IsAuthenticated == true &&
                            User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                                Admin
                                </a>
                            </li>
                        }

                    </ul>


                    <!-- ================= ACCOUNT ================= -->

                    <div class="header-account">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- ĐÃ ĐĂNG NHẬP -->

                            <div class="dropdown">

                                <button class="btn btn-login dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-person-circle me-1"></i>

                                    Xin chào,
                                    @User.Identity.Name

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">

                                    <!-- TÀI KHOẢN -->

                                    <li>

                                        <a class="dropdown-item"
                                           href="#">

                                            <i class="bi bi-person me-2"></i>

                                            Tài khoản

                                        </a>

                                    </li>


                                    <!-- ĐƠN HÀNG -->

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Booking"
                                           asp-action="Index">

                                            <i class="bi bi-receipt me-2"></i>

                                            Đơn của tôi

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- ĐĂNG XUẤT -->

                                    <li>

                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Đăng xuất

                                        </a>

                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <!-- CHƯA ĐĂNG NHẬP -->

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-login">

                                <i class="bi bi-person"></i>

                                Đăng nhập

                            </a>


                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-register">

                                Đăng ký

                            </a>
                        }

                    </div>

                </div>

            </nav>

        </div>

    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <main>

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="travel-footer">

        <div class="container">

            <div class="row g-4">

                <!-- ABOUT -->

                <div class="col-lg-4 col-md-6">

                    <div class="footer-logo">

                        <i class="bi bi-airplane"></i>

                        Travel<span>AI</span>

                    </div>

                    <p class="footer-description">

                        Nền tảng du lịch thông minh giúp bạn tìm kiếm,
                        lựa chọn và lên kế hoạch cho chuyến đi phù hợp
                        với nhu cầu và ngân sách.

                    </p>

                </div>


                <!-- QUICK LINKS -->

                <div class="col-lg-2 col-md-6">

                    <h5>Khám phá</h5>

                    <ul class="footer-links">

                        <li>

                            <a asp-controller="Tour"
                               asp-action="Index">

                                Tour du lịch

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Hotel"
                               asp-action="Index">

                                Khách sạn

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Combo"
                               asp-action="Index">

                                Combo

                            </a>

                        </li>

                        <li>

                            <a href="#">

                                Điểm đến

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- SUPPORT -->

                <div class="col-lg-3 col-md-6">

                    <h5>Hỗ trợ</h5>

                    <ul class="footer-links">

                        <li>

                            <a href="#">

                                Trung tâm trợ giúp

                            </a>

                        </li>

                        <li>

                            <a href="#">

                                Chính sách đặt dịch vụ

                            </a>

                        </li>

                        <li>

                            <a href="#">

                                Điều khoản sử dụng

                            </a>

                        </li>

                        <li>

                            <a href="#">

                                Liên hệ

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- AI -->

                <div class="col-lg-3 col-md-6">

                    <h5>Travel AI</h5>

                    <p class="footer-description">

                        Hãy để AI giúp bạn tìm điểm đến,
                        tour và khách sạn phù hợp.

                    </p>

                    <a asp-controller="AI"
                       asp-action="Index"
                       class="btn ai-footer-button">

                        <i class="bi bi-stars"></i>

                        Khám phá với AI

                    </a>

                </div>

            </div>


            <hr />


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">

                <span>

                    © @DateTime.Now.Year TravelAI.
                    All rights reserved.

                </span>

                <div class="social-links">

                    <a href="#">

                        <i class="bi bi-facebook"></i>

                    </a>

                    <a href="#">

                        <i class="bi bi-instagram"></i>

                    </a>

                    <a href="#">

                        <i class="bi bi-youtube"></i>

                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>